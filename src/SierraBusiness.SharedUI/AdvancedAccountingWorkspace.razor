@using Microsoft.JSInterop
@inject IFinanceService Finance
@inject IJSRuntime JS
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
<section class="panel"><h2>Advanced accounting</h2><div class="form-grid"><label>From<input type="date" @bind="from" /></label><label>To or as at<input type="date" @bind="to" /></label></div><button class="secondary" disabled="@busy" @onclick="Refresh">Refresh accounting analysis</button><button class="secondary" disabled="@(busy || structure is null)" @onclick="Export">Export accounting analysis</button></section>
<div class="view-toggle report-tabs" role="tablist">@foreach (var t in new[] { "Account groups", "Cost centres", "Scenarios", "Interest", "Projects and schedules" }) { <button type="button" role="tab" aria-selected="@(tab == t)" class="@(tab == t ? "active" : "")" @onclick="() => Open(t)">@t</button> }</div>
@if (structure is null || accounts is null) { <p>Loading accounting structures…</p> }
else if (tab == "Projects and schedules")
{
    <AccountingProductivityWorkspace Actor="Actor" @ref="productivityWorkspace" />
}
else if (tab == "Account groups")
{
    @if (CanWrite)
    {
        <section class="panel"><h2>@(groupId is null ? "New account group" : "Edit account group")</h2><div class="form-grid">
        <label>Group name<input maxlength="100" @bind="groupName" /></label><label>Account nature<select @bind="nature" @bind:after="ClearGroupParent">@foreach (var n in Enum.GetValues<LedgerGroup>()) { <option value="@n">@n</option> }</select></label><label>Parent group<select @bind="groupParent"><option value="@Guid.Empty">Root group</option>@foreach (var g in structure.Groups.Where(g => g.Nature == nature && g.Id != groupId)) { <option value="@g.Id">@g.Name</option> }</select></label></div><button class="primary" disabled="@busy" @onclick="SaveGroup">Save account group</button><button class="secondary" @onclick="NewGroup">New group</button></section>
        <section class="panel"><h2>Assign a ledger</h2><div class="form-grid"><label>Ledger account<select @bind="ledger" @bind:after="ChooseLedger">@foreach (var a in accounts.Accounts) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Account group<select @bind="ledgerGroup"><option value="@Guid.Empty">Not grouped</option>@foreach (var g in structure.Groups.Where(g => g.Nature == accounts.Accounts.SingleOrDefault(a => a.Code == ledger)?.Group)) { <option value="@g.Id">@g.Name</option> }</select></label></div><button class="primary" disabled="@busy" @onclick="Assign">Save ledger grouping</button></section>
    }
    <section class="panel"><h2>Grouped balances</h2><p>Parent amounts include descendants. Do not add parent and child totals together. Income and expense use period activity; assets liabilities and equity use closing balances. Grouping never changes the ledger’s nature or its posted entries.</p><div class="table-wrap"><table><thead><tr><th>Group</th><th>Nature</th><th>Parent level</th><th>Amount</th><th></th></tr></thead><tbody>@foreach (var g in report!.Groups) { <tr><td>@g.Name</td><td>@g.Nature</td><td>@g.Depth</td><td>@Money(g.Amount)</td><td>@if (CanWrite && g.Id is Guid id) { <button class="text-button" @onclick="() => EditGroup(structure.Groups.Single(x => x.Id == id))">Edit group</button> }</td></tr> }</tbody></table></div></section>
}
else if (tab == "Cost centres")
{
    @if (CanWrite)
    {
        <section class="panel"><h2>@(centreId is null ? "New cost centre" : "Edit cost centre")</h2><div class="form-grid"><label>Centre code<input maxlength="100" disabled="@(centreId is not null)" @bind="centreCode" /></label><label>Centre name<input maxlength="100" @bind="centreName" /></label><label>Parent centre<select @bind="centreParent"><option value="@Guid.Empty">No parent</option>@foreach (var c in structure.Centres.Where(c => c.Id != centreId)) { <option value="@c.Id">@c.Code · @c.Name</option> }</select></label><label class="check"><input type="checkbox" @bind="centreActive" />Active centre</label></div><button class="primary" @onclick="SaveCentre" disabled="@busy">Save cost centre</button><button class="secondary" @onclick="NewCentre">New centre</button></section>
        <section class="panel"><h2>Allocate a payment or receipt</h2><p>Split one custom expense payment or income receipt across centres. Percentages total 100 and the final share takes the rounding remainder. This posts a real voucher after review; scenario vouchers below do not post.</p><div class="form-grid">
        <label>Allocation type<select @bind="income" @bind:after="ChooseAllocationAccount"><option value="false">Expense payment</option><option value="true">Income receipt</option></select></label><label>Income or expense account<select @bind="allocationAccount" @bind:after="ClearAllocation">@foreach (var a in AllocationAccounts) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Cash or bank account<select @bind="funds" @bind:after="ClearAllocation">@foreach (var a in accounts.Accounts.Where(a => a.CashOrBank)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Voucher date<input type="date" @bind="allocationDate" @bind:after="ClearAllocation" /></label><label>Allocation amount<input type="number" min="0.01" step="0.01" @bind="amount" @bind:after="ClearAllocation" /></label><label>Narration<input maxlength="200" @bind="narration" @bind:after="ClearAllocation" /></label></div>
        <div class="table-wrap"><table><thead><tr><th>Centre</th><th>Share percent</th></tr></thead><tbody>@foreach (var c in structure.Centres.Where(c => c.Active)) { <tr><td>@c.Code · @c.Name</td><td><input type="number" min="0" max="100" step="0.01" aria-label="Share for @c.Code" value="@shares.GetValueOrDefault(c.Id)" @onchange="e => Share(c.Id, e)" /></td></tr> }</tbody></table></div><button class="secondary" disabled="@busy" @onclick="PreviewAllocation">Review allocation</button>
        @if (allocationPreview is not null) { <table><thead><tr><th>Ledger</th><th>Centre</th><th>Debit</th><th>Credit</th></tr></thead><tbody>@foreach (var line in allocationPreview.Lines) { <tr><td>@line.AccountCode</td><td>@line.CostCentre</td><td>@Money(line.Debit)</td><td>@Money(line.Credit)</td></tr> }</tbody></table><button class="primary" disabled="@busy" @onclick="PostAllocation">Post allocated voucher</button> }
        </section>
    }
    <section class="panel"><h2>Cost centre activity</h2><p>These are direct centre amounts. Legacy free-text centres and unallocated entries remain visible; parent centres are organizational headings rather than duplicate totals.</p><div class="table-wrap"><table><thead><tr><th>Code and name</th><th>Income</th><th>Expenses</th><th>Profit</th><th></th></tr></thead><tbody>@foreach (var c in report!.Centres) { <tr><td>@c.Code · @c.Name</td><td>@Money(c.Income)</td><td>@Money(c.Expenses)</td><td>@Money(c.Profit)</td><td>@if (CanWrite && structure.Centres.FirstOrDefault(x => x.Code.Equals(c.Code, StringComparison.OrdinalIgnoreCase)) is { } saved) { <button class="text-button" @onclick="() => EditCentre(saved)">Edit centre</button> }</td></tr> }</tbody></table></div></section>
}
else if (tab == "Scenarios")
{
    <p class="hint">Scenarios and memoranda are planning records. They never alter journals stock bills tax returns or actual reports. Projected values are shown separately.</p>
    @if (CanWrite)
    {
        <section class="panel"><h2>@(scenarioId is null ? "New scenario" : "Edit scenario")</h2><div class="form-grid"><label>Scenario name<input maxlength="100" @bind="scenarioName" /></label><label>Scenario type<select @bind="scenarioKind">@foreach (var k in Enum.GetValues<ScenarioKind>()) { <option value="@k">@k</option> }</select></label><label>Scenario date<input type="date" @bind="scenarioDate" /></label><label>Scenario note<input maxlength="1000" @bind="scenarioNote" /></label><label class="check"><input type="checkbox" @bind="scenarioActive" />Active scenario</label></div>
        @if (scenarioKind == ScenarioKind.Adjustment)
        {
            <div class="form-grid"><label>Scenario ledger<select @bind="scenarioAccount">@foreach (var a in accounts.Accounts) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Debit<input type="number" min="0" step="0.01" @bind="scenarioDebit" /></label><label>Credit<input type="number" min="0" step="0.01" @bind="scenarioCredit" /></label></div><button class="secondary" @onclick="AddScenarioLine">Add scenario line</button>
            <table><thead><tr><th>Account</th><th>Debit</th><th>Credit</th><th></th></tr></thead><tbody>@foreach (var line in scenarioLines.ToArray()) { <tr><td>@line.AccountCode</td><td>@Money(line.Debit)</td><td>@Money(line.Credit)</td><td><button class="text-button" @onclick="() => scenarioLines.Remove(line)">Remove draft line</button></td></tr> }</tbody></table>
        }
        <button class="primary" disabled="@busy" @onclick="SaveScenario">Save non posting scenario</button><button class="secondary" @onclick="NewScenario">New scenario</button></section>
    }
    <section class="panel"><h2>Choose scenarios to project</h2>@foreach (var s in scenarios) { <label class="check"><input type="checkbox" checked="@chosen.Contains(s.Id)" disabled="@(!s.Active || s.Date < from || s.Date > to)" @onchange="e => ChooseScenario(s.Id, e.Value is true)" />@s.Name · @s.Date · @s.Kind @(s.Active ? "" : "inactive")</label>@if (CanWrite) { <button class="text-button" @onclick="() => EditScenario(s)">Edit scenario</button> } }<button class="secondary" disabled="@busy" @onclick="Project">Calculate scenario projection</button>
    @if (projection is not null) { <p>Actual profit @Money(projection.ActualProfit) · Projected profit @Money(projection.ProjectedProfit)</p><div class="table-wrap"><table><thead><tr><th>Account</th><th>Actual</th><th>Scenario change</th><th>Projected</th></tr></thead><tbody>@foreach (var b in projection.Balances.Where(b => b.Actual != 0 || b.Change != 0)) { <tr><td>@b.Code · @b.Name</td><td>@Money(b.Actual)</td><td>@Money(b.Change)</td><td>@Money(b.Projected)</td></tr> }</tbody></table></div> }</section>
}
else if (tab == "Interest")
{
    <section class="panel"><h2>Interest worksheet</h2><p>This is a calculation using an agreed rate, not an automatic charge or a statutory rate. It starts after the due date plus grace days and uses daily closing balances. Payments and bill credits reduce the balance on their document date; reversals restore it on their reversal date. Each bill is rounded once.</p><div class="form-grid"><label>Annual rate percent<input type="number" min="0" max="100" step="0.01" @bind="rate" /></label><label>Grace days<input type="number" min="0" max="3660" @bind="grace" /></label><label>Day count basis<select @bind="basis"><option value="@InterestBasis.Actual365">Actual days divided by 365</option><option value="@InterestBasis.ActualYear">Actual days divided by days in year</option><option value="@InterestBasis.Actual360">Actual days divided by 360</option></select></label><label>Bill type<select @bind="receivable"><option value="true">Customer receivables</option><option value="false">Supplier payables</option></select></label><label>Exact party optional<input @bind="interestParty" /></label></div><button class="secondary" disabled="@busy" @onclick="CalculateInterest">Calculate interest worksheet</button>
    @if (interest is not null) { <p>Calculated interest @Money(interest.Total). No bill or journal has been created.</p><div class="table-wrap"><table><thead><tr><th>Document and party</th><th>Due</th><th>Charged days</th><th>Start balance</th><th>End balance</th><th>Interest</th></tr></thead><tbody>@foreach (var r in interest.Rows) { <tr><td>@r.Number · @r.Party</td><td>@r.Due</td><td>@r.ChargedDays</td><td>@Money(r.StartBalance)</td><td>@Money(r.EndBalance)</td><td>@Money(r.Interest)</td></tr> }</tbody></table></div> }</section>
}
@code {
    [Parameter] public Actor Actor { get; set; } = default!;
    private bool CanWrite => Actor.Permissions.Contains("accounting.write"); private bool busy;
    private AccountingProductivityWorkspace? productivityWorkspace;
    private string tab = "Account groups", error = "", message = "";
    private AccountingStructure? structure; private FinanceSnapshot? accounts; private StructuredReport? report; private IReadOnlyList<ScenarioView> scenarios = [];
    private DateOnly from = new(DateTime.Today.Year, DateTime.Today.Month, 1), to = DateOnly.FromDateTime(DateTime.Today);
    private Guid? groupId, centreId, scenarioId; private int groupVersion, centreVersion, scenarioVersion, ledgerVersion;
    private Guid groupParent, ledgerGroup, centreParent; private string groupName = "", centreCode = "", centreName = ""; private LedgerGroup nature = LedgerGroup.Expense;
    private int ledger, allocationAccount, funds = 1000; private bool centreActive = true, income; private DateOnly allocationDate = DateOnly.FromDateTime(DateTime.Today); private decimal amount; private string narration = ""; private readonly Dictionary<Guid, decimal> shares = []; private CentreAllocationPreview? allocationPreview;
    private string scenarioName = "", scenarioNote = ""; private ScenarioKind scenarioKind; private DateOnly scenarioDate = DateOnly.FromDateTime(DateTime.Today); private bool scenarioActive = true; private readonly List<VoucherLine> scenarioLines = []; private int scenarioAccount; private decimal scenarioDebit, scenarioCredit; private readonly HashSet<Guid> chosen = []; private ScenarioReport? projection;
    private decimal rate; private int grace; private InterestBasis basis; private bool receivable = true; private string interestParty = ""; private InterestReport? interest;
    private Guid groupOperation = Guid.NewGuid(), mappingOperation = Guid.NewGuid(), centreOperation = Guid.NewGuid(), allocationOperation = Guid.NewGuid(), scenarioOperation = Guid.NewGuid();
    private string groupBaseline = "", centreBaseline = "", scenarioBaseline = ""; private Guid mappingBaseline;
    private string GroupValues => System.Text.Json.JsonSerializer.Serialize(new { groupName, nature, groupParent });
    private string CentreValues => System.Text.Json.JsonSerializer.Serialize(new { centreCode, centreName, centreParent, centreActive });
    private string ScenarioValues => System.Text.Json.JsonSerializer.Serialize(new { scenarioName, scenarioNote, scenarioKind, scenarioDate, scenarioActive, scenarioLines, scenarioDebit, scenarioCredit });
    public bool HasDraft => productivityWorkspace?.HasDraft == true || groupBaseline.Length > 0 && GroupValues != groupBaseline || centreBaseline.Length > 0 && CentreValues != centreBaseline || scenarioBaseline.Length > 0 && ScenarioValues != scenarioBaseline || ledgerGroup != mappingBaseline || narration.Length > 0 || amount != 0 || shares.Any(s => s.Value != 0);
    private IEnumerable<LedgerDefinition> AllocationAccounts => accounts?.Accounts.Where(a => !a.Control && a.Group == (income ? LedgerGroup.Income : LedgerGroup.Expense)) ?? [];
    private static string Money(decimal value) => value.ToString("N2");
    protected override async Task OnInitializedAsync() { await Run(Load); if (accounts is not null) { ledger = accounts.Accounts.First().Code; scenarioAccount = ledger; ChooseLedger(); ChooseAllocationAccount(); } groupBaseline = GroupValues; centreBaseline = CentreValues; scenarioBaseline = ScenarioValues; }
    private async Task Load() { structure = await Finance.Structure(); accounts = await Finance.Read(from, to); report = await Finance.StructureReport(from, to); scenarios = await Finance.Scenarios(); chosen.RemoveWhere(id => !scenarios.Any(s => s.Id == id && s.Active && s.Date >= from && s.Date <= to)); projection = null; interest = null; }
    private Task Refresh() => Run(Load);
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (ApprovalRequiredException e) { error = e.Message + " Review the request in Approvals before posting."; } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException or JSException) { error = e.Message; } catch { error = "Accounting analysis could not complete. Refresh and check saved records before retrying."; } finally { busy = false; } }
    private async Task Open(string t) { if (t == tab) return; if (HasDraft && !await JS.InvokeAsync<bool>("confirm", "Leave this accounting editor with unsaved changes?")) return; tab = t; error = message = ""; }
    private void ClearGroupParent() => groupParent = Guid.Empty;
    private void NewGroup() { groupId = null; groupVersion = 0; groupName = ""; groupParent = Guid.Empty; groupOperation = Guid.NewGuid(); groupBaseline = GroupValues; }
    private void EditGroup(AccountGroupView g) { groupId = g.Id; groupVersion = g.Version; groupName = g.Name; nature = g.Nature; groupParent = g.ParentId ?? Guid.Empty; groupOperation = Guid.NewGuid(); groupBaseline = GroupValues; }
    private Task SaveGroup() => Run(async () => { await Finance.SaveAccountGroup(new(groupOperation, groupId, groupVersion, groupName, nature, groupParent == Guid.Empty ? null : groupParent)); NewGroup(); await Load(); message = "Account group saved."; });
    private void ChooseLedger() { var map = structure?.Ledgers.SingleOrDefault(m => m.AccountCode == ledger); ledgerGroup = map?.GroupId ?? Guid.Empty; ledgerVersion = map?.Version ?? 0; mappingOperation = Guid.NewGuid(); mappingBaseline = ledgerGroup; }
    private Task Assign() => Run(async () => { await Finance.AssignLedgerGroup(new(mappingOperation, ledger, ledgerVersion, ledgerGroup == Guid.Empty ? null : ledgerGroup)); await Load(); ChooseLedger(); message = "Ledger grouping saved."; });
    private void NewCentre() { centreId = null; centreVersion = 0; centreCode = centreName = ""; centreParent = Guid.Empty; centreActive = true; centreOperation = Guid.NewGuid(); centreBaseline = CentreValues; }
    private void EditCentre(CostCentreView c) { centreId = c.Id; centreVersion = c.Version; centreCode = c.Code; centreName = c.Name; centreParent = c.ParentId ?? Guid.Empty; centreActive = c.Active; centreOperation = Guid.NewGuid(); centreBaseline = CentreValues; }
    private Task SaveCentre() => Run(async () => { await Finance.SaveCostCentre(new(centreOperation, centreId, centreVersion, centreCode, centreName, centreParent == Guid.Empty ? null : centreParent, centreActive)); NewCentre(); await Load(); message = "Cost centre saved."; });
    private void ClearAllocation() => allocationPreview = null;
    private void ChooseAllocationAccount() { allocationAccount = AllocationAccounts.FirstOrDefault()?.Code ?? 0; ClearAllocation(); }
    private void Share(Guid id, ChangeEventArgs e) { if (decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n)) shares[id] = n; else shares[id] = 0; ClearAllocation(); }
    private AllocateCentreCommand Allocation() => new(allocationOperation, allocationDate, narration, allocationAccount, funds, income, amount, shares.Where(s => s.Value != 0).Select(s => new CentreShare(s.Key, s.Value)).ToList());
    private Task PreviewAllocation() => Run(async () => allocationPreview = await Finance.PreviewCentreAllocation(Allocation()));
    private Task PostAllocation() => Run(async () => { await Finance.PostCentreAllocation(Allocation()); allocationOperation = Guid.NewGuid(); amount = 0; narration = ""; shares.Clear(); allocationPreview = null; await Load(); message = "Allocated voucher posted with a balanced journal."; });
    private void NewScenario() { scenarioId = null; scenarioVersion = 0; scenarioName = scenarioNote = ""; scenarioLines.Clear(); scenarioDebit = scenarioCredit = 0; scenarioActive = true; scenarioOperation = Guid.NewGuid(); scenarioBaseline = ScenarioValues; }
    private void EditScenario(ScenarioView s) { scenarioId = s.Id; scenarioVersion = s.Version; scenarioName = s.Name; scenarioNote = s.Note; scenarioDate = s.Date; scenarioKind = s.Kind; scenarioActive = s.Active; scenarioLines.Clear(); scenarioLines.AddRange(s.Lines); scenarioOperation = Guid.NewGuid(); scenarioBaseline = ScenarioValues; }
    private void AddScenarioLine() { scenarioLines.Add(new(scenarioAccount, scenarioDebit, scenarioCredit)); scenarioDebit = scenarioCredit = 0; }
    private Task SaveScenario() => Run(async () => { await Finance.SaveScenario(new(scenarioOperation, scenarioId, scenarioVersion, scenarioName, scenarioKind, scenarioDate, scenarioNote, scenarioLines.ToList(), scenarioActive)); NewScenario(); await Load(); message = "Scenario saved. Actual accounting records are unchanged."; });
    private void ChooseScenario(Guid id, bool value) { if (value) chosen.Add(id); else chosen.Remove(id); projection = null; }
    private Task Project() => Run(async () => projection = await Finance.ProjectScenarios(from, to, chosen.ToArray()));
    private InterestRequest InterestRequest() => new(from, to, rate, grace, basis, receivable, interestParty);
    private Task CalculateInterest() => Run(async () => interest = await Finance.Interest(InterestRequest()));
    private Task Export() => Run(async () => { var bytes = await Finance.ExportAdvanced(from, to, chosen.ToArray(), interest?.Request); await JS.InvokeVoidAsync("sierraDownload", "Accounting-analysis.xlsx", Convert.ToBase64String(bytes)); });
}
