@inject ISyncService Sync
@inject IServiceProvider Services
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
@if (status is { } s)
{
    <section class="panel"><div class="panel-title"><h2>@RoleTitle(s.Role)</h2>
        @if (s.Role == SyncRole.Branch) { <button class="primary" disabled="@busy" @onclick="SyncNow">@(busy ? "Syncing…" : "Sync now")</button> }</div>
        @if (s.Role == SyncRole.Off)
        {
            <p>This installation works on its own. To join head office, enter head office's address and this branch's key below, then restart Rokela Business Admin. Records made before joining are sent on the first sync.</p>
        }
        else if (s.Role == SyncRole.Branch)
        {
            var c = s.Central;
            <div class="metrics">
                <section><small>BRANCH</small><strong>@s.Branch</strong><span>@s.Server</span></section>
                <section><small>WAITING TO SEND</small><strong>@s.PendingChanges.ToString("N0") <em>changes</em></strong><span>Kept safely here until head office confirms</span></section>
                <section><small>LAST SUCCESSFUL SYNC</small><strong>@(c?.LastSuccess is DateTimeOffset t ? t.ToLocalTime().ToString("dd MMM HH:mm") : "Never")</strong><span>@(c?.LastError is { Length: > 0 } e ? e : "Every 5 minutes while the app is open")</span></section>
            </div>
        }
        else
        {
            <p>Head office for <strong>@s.Branch</strong>. Branches send their records here and receive the shared catalogue, price rules and settings.</p>
            <div class="table-wrap"><table><thead><tr><th>Branch</th><th>Last contact</th><th>Last successful exchange</th><th class="numeric">Changes received to</th><th>Note</th></tr></thead>
                <tbody>@foreach (var p in s.Peers) { <tr><td>@p.Name</td><td>@Time(p.LastAttempt)</td><td>@Time(p.LastSuccess)</td><td class="numeric">@p.Pushed.ToString("N0")</td><td>@p.LastError</td></tr> }</tbody></table></div>
            @if (s.Peers.Count == 0) { <p class="hint">No branch has connected yet.</p> }
        }
    </section>
    <section class="panel"><h2>Conflicts</h2>
        <p class="hint">A conflict is a record changed in two places, or one that could not be applied. Head office's version is kept for shared records, and posted history is never overwritten. Check each one and mark it reviewed.</p>
        <div class="table-wrap"><table><thead><tr><th>When</th><th>From</th><th>Record</th><th>What happened</th><th></th></tr></thead>
            <tbody>@foreach (var x in s.Conflicts.Where(x => showReviewed || !x.Reviewed)) { <tr><td>@x.Time.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@x.Origin</td><td>@x.Entity</td><td>@x.Reason</td><td>@if (!x.Reviewed) { <button class="text-button" disabled="@busy" @onclick="() => Review(x.Id)">Mark reviewed</button> } else { <span>Reviewed</span> }</td></tr> }</tbody></table></div>
        @if (!s.Conflicts.Any(x => !x.Reviewed)) { <p class="hint">No conflicts to review.</p> }
        <label class="check"><input type="checkbox" @bind="showReviewed" /> Show reviewed</label>
    </section>
}
@if (settings is { } cfg)
{
    @if (cfg.Warning.Length > 0) { <div class="notice error" role="alert">@cfg.Warning</div> }
    <section class="panel"><h2>Connection to head office</h2>
        @if (!cfg.Editable) { <p class="hint">Set on the server in the Sync section of the configuration (Role, Server, Key, or Keys for each branch).</p> }
        else if (!Actor.Permissions.Contains("users.manage")) { <p class="hint">Only an owner or administrator can change the connection.</p> }
        else
        {
            <div class="form-grid">
                <label>Head office address<input placeholder="https://head-office.example.com" maxlength="300" @bind="server" /></label>
                <label>Branch key @(cfg.HasKey ? "(saved — leave blank to keep)" : "")<input type="password" autocomplete="new-password" maxlength="200" @bind="key" /></label>
            </div>
            <button class="primary" disabled="@busy" @onclick="SaveSettings">Save connection</button>
            <p class="hint">Leave the address blank to stop syncing. Restart Rokela Business Admin after saving.</p>
        }
    </section>
}
@code {
    [Parameter, EditorRequired] public Actor Actor { get; set; } = default!;
    private SyncStatusView? status; private SyncSettingsView? settings; private ISyncSettings? store;
    private bool busy, showReviewed; private string error = "", message = "", server = "", key = "";
    protected override async Task OnInitializedAsync() { store = Services.GetService(typeof(ISyncSettings)) as ISyncSettings; settings = store?.Read(); server = settings?.Server ?? ""; await Run(Load); }
    private async Task Load() => status = await Sync.Status();
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } catch (Exception) { error = "The action could not complete. Try again."; } finally { busy = false; } }
    private Task SyncNow() => Run(async () => { var r = await Sync.SyncNow(); message = r.Message; await Load(); });
    private Task Review(Guid id) => Run(async () => { await Sync.MarkReviewed(id); await Load(); });
    private Task SaveSettings() => Run(() => { store!.Save(server, key.Length == 0 ? null : key); key = ""; settings = store.Read(); message = "Connection saved. Restart Rokela Business Admin to apply it."; return Task.CompletedTask; });
    private static string RoleTitle(SyncRole role) => role switch { SyncRole.Branch => "Branch sync", SyncRole.Central => "Head office sync", _ => "Branch sync is off" };
    private static string Time(DateTimeOffset? t) => t is DateTimeOffset v ? v.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "—";
}
