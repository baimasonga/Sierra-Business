@using Microsoft.JSInterop
@inject IPurchasingService Purchasing
@inject IFinanceService Finance
@inject IBusinessService Business
@inject IPartyService Parties
@inject IInventoryService Inventory
@inject IJSRuntime JS
@inject IServiceProvider Services
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
<DocumentDraftRecovery @ref="recovery" Scope="fxsales" Enabled="@CanSell" Busy="busy" HasDraft="@HasInvoice" Current="@RecoveryDraft" OnRestore="RestoreInvoice" />
<div class="view-toggle report-tabs" role="tablist">@foreach (var t in Tabs) { <button type="button" role="tab" aria-selected="@(tab == t)" class="@(tab == t ? "active" : "")" @onclick="() => Open(t)">@t</button> }</div>
@if (snapshot is null) { <p>Loading foreign exchange workspace…</p> }
else if (tab == "Foreign invoices")
{
    <section class="panel"><h2>Foreign customer invoice</h2><p>Enter agreed prices in the selected currency. Stock cost, tax and journals remain in NLe at the invoice-date rate. This is a direct named-customer credit invoice; receive payment separately from Settlements. Existing order, bundle, delivery and held-sale workflows remain in local currency.</p>
    @if (CanSell)
    {
        <div class="form-grid"><label>Customer<select @bind="customer"><option value="">Choose customer</option>@foreach (var p in parties.Where(p => p.Type is PartyType.Customer or PartyType.Both)) { <option value="@p.Name">@p.Name</option> }</select></label><label>Invoice date<input type="date" @bind="invoiceDate" /></label><label>Due date<input type="date" @bind="due" /></label><label>Invoice currency<select @bind="currency"><option value="">Choose currency</option>@foreach (var c in rates.Select(r => r.Currency).Distinct()) { <option value="@c">@c</option> }</select></label><label>Warehouse<select @bind="location">@foreach (var l in locations) { <option value="@l.Code">@l.Name</option> }</select></label>
        <label>Product<select @bind="product"><option value="@Guid.Empty">Choose product</option>@foreach (var p in snapshot.Products) { <option value="@p.Id">@p.Sku · @p.Name</option> }</select></label><label>Quantity<input type="number" min="0.0001" step="0.0001" @bind="quantity" /></label><label>Unit price in invoice currency<input type="number" min="0.0001" step="0.0001" @bind="price" /></label><label>Base units per entered unit<input type="number" min="0.0001" step="0.0001" @bind="conversion" /></label><label>Serial<input maxlength="100" @bind="serial" /></label><label>Batch<input maxlength="100" @bind="batch" /></label><label>Expiry<input type="date" @bind="expiry" /></label></div><button class="secondary" disabled="@busy" @onclick="AddLine">Add foreign invoice line</button>
        <div class="table-wrap"><table><thead><tr><th>Product</th><th>Quantity</th><th>Unit price / @currency</th><th>Amount / @currency</th><th></th></tr></thead><tbody>@foreach (var line in lines.ToArray()) { <tr><td>@snapshot.Products.Single(p => p.Id == line.ProductId).Name</td><td>@line.Quantity × @line.Conversion</td><td>@line.UnitPrice</td><td>@Money(AccountingEngine.Money(line.Quantity * line.UnitPrice))</td><td><button class="text-button" @onclick="() => lines.Remove(line)">Remove draft line</button></td></tr> }</tbody></table></div>
        <p>Source subtotal @currency @Money(lines.Sum(l => AccountingEngine.Money(l.Quantity * l.UnitPrice))). Tax is calculated when posted. Pricing limits and credit controls are checked in local currency.</p><button class="primary" disabled="@(busy || lines.Count == 0)" @onclick="PostInvoice">Post foreign customer invoice</button>
    }
    else { <p>Your role can review and settle invoices but cannot create sales.</p> }
    </section>
}
else if (tab == "Settlements")
{
    <section class="panel"><h2>Foreign bill settlement</h2><p>Local funds record the NLe actually converted or paid. A currency bank retains the foreign units: customer receipts use the date's reference rate and supplier payments use the bank's carrying value. Review the invoice amount and local value before posting.</p>
    @if (CanWrite)
    {
        <div class="form-grid"><label>Direction<select @bind="collect" @bind:after="ClearBill"><option value="true">Customer receipt</option><option value="false">Supplier payment</option></select></label><label>Foreign bill<select @bind="billId" @bind:after="PrepareBill"><option value="@Guid.Empty">Choose bill</option>@if (collect) { @foreach (var b in receivables) { <option value="@b.BillId">@b.Customer · @b.Number · @b.Currency @b.SourceOutstanding</option> } } else { @foreach (var b in payables) { <option value="@b.BillId">@b.Party · @b.Number · @b.Currency @b.SourceOutstanding</option> } }</select></label>
        <label>Settlement date<input type="date" @bind="settlementDate" @bind:after="Reprice" /></label><label>Funds account<select @bind="funds" @bind:after="Reprice">@foreach (var a in accounts) { <option value="@a.Code">@a.Code · @a.Name @(banks.SingleOrDefault(b => b.AccountCode == a.Code)?.Currency ?? "NLe")</option> }</select></label><label>Foreign amount<input type="number" min="0.01" step="0.01" @bind="sourceAmount" @bind:after="Reprice" /></label><label>NLe receipt or bank carrying value<input type="number" min="0.01" step="0.01" readonly="@(banks.Any(b => b.AccountCode == funds))" @bind="localAmount" /></label><label>Settlement reference<input maxlength="100" @bind="settlementReference" /></label></div><button class="primary" disabled="@(busy || billId == Guid.Empty)" @onclick="Settle">Post foreign settlement</button>
    }
    <h3>Customer foreign balances</h3><div class="table-wrap"><table><thead><tr><th>Customer and invoice</th><th>Currency</th><th>Source outstanding</th><th>Original carrying outstanding / NLe</th></tr></thead><tbody>@foreach (var b in receivables) { <tr><td>@b.Customer · @b.Number</td><td>@b.Currency</td><td>@Money(b.SourceOutstanding)</td><td>@Money(b.LocalCarrying)</td></tr> }</tbody></table></div><h3>Supplier foreign balances</h3><div class="table-wrap"><table><thead><tr><th>Supplier and bill</th><th>Currency</th><th>Source outstanding</th><th>Original carrying outstanding / NLe</th></tr></thead><tbody>@foreach (var b in payables) { <tr><td>@b.Party · @b.Number</td><td>@b.Currency</td><td>@Money(b.SourceOutstanding)</td><td>@Money(b.CarryingOutstanding)</td></tr> }</tbody></table></div>
    </section>
}
else if (tab == "Currency banks")
{
    <section class="panel"><h2>Currency bank balances</h2><label>Balance as at<input type="date" @bind="asAt" @bind:after="RefreshBanks" /></label><div class="table-wrap"><table><thead><tr><th>Account</th><th>Currency</th><th>Foreign units</th><th>NLe carrying amount</th></tr></thead><tbody>@foreach (var b in banks) { <tr><td>@b.AccountCode · @b.Name</td><td>@b.Currency</td><td>@Money(b.SourceBalance)</td><td>@Money(b.LocalCarrying)</td></tr> }</tbody></table></div></section>
    @if (CanWrite)
    {
        <section class="panel"><h2>Assign a currency to an unused bank ledger</h2><p>Create a custom cash/bank asset ledger under Accounting first. Its currency is fixed after assignment; existing local transactions cannot be reinterpreted.</p><div class="form-grid"><label>Custom bank ledger<select @bind="newBank"><option value="0">Choose ledger</option>@foreach (var a in accounts.Where(a => a.Code >= 6000 && !banks.Any(b => b.AccountCode == a.Code))) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Bank currency<select @bind="bankCurrency"><option value="">Choose currency</option>@foreach (var c in rates.Select(r => r.Currency).Distinct()) { <option value="@c">@c</option> }</select></label></div><button class="primary" disabled="@busy" @onclick="ConfigureBank">Save currency bank</button></section>
        <section class="panel"><h2>Currency bank transaction</h2><div class="form-grid"><label>Transaction type<select @bind="tradeKind" @bind:after="ClearTrade"><option value="@ForeignBankTradeKind.Deposit">Deposit or funding</option><option value="@ForeignBankTradeKind.Withdrawal">Withdrawal or expense</option><option value="@ForeignBankTradeKind.Transfer">Transfer or exchange</option></select></label><label>Currency bank<select @bind="tradeBank" @bind:after="ClearTrade"><option value="0">Choose bank</option>@foreach (var b in banks) { <option value="@b.AccountCode">@b.AccountCode · @b.Name · @b.Currency</option> }</select></label><label>Counter ledger<select @bind="counter" @bind:after="ClearTrade">@foreach (var a in allAccounts) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Trade date<input type="date" @bind="tradeDate" @bind:after="ClearTrade" /></label><label>Foreign units<input type="number" min="0.01" step="0.01" @bind="tradeSource" @bind:after="ClearTrade" /></label><label>NLe value for deposit or withdrawal<input type="number" min="0" step="0.01" @bind="tradeLocal" @bind:after="ClearTrade" /></label><label>Target currency units for transfer<input type="number" min="0" step="0.01" @bind="targetSource" @bind:after="ClearTrade" /></label><label>Trade reference<input maxlength="160" @bind="tradeReference" @bind:after="ClearTrade" /></label></div><p class="hint">Same-currency transfers preserve units. Other-currency transfers value the target currency at its dated reference rate. Withdrawals consume the source bank's carrying value. Use a local funding ledger for deposits; do not post manual vouchers into a configured currency bank.</p><button class="secondary" disabled="@busy" @onclick="PreviewTrade">Review currency bank transaction</button>
        @if (tradePreview is not null) { <p>Source units after @tradePreview.SourceBalanceAfter · Source carrying used NLe @Money(tradePreview.SourceCarryingUsed) · Target units after @tradePreview.TargetSourceBalanceAfter</p><table><thead><tr><th>Ledger</th><th>Debit / NLe</th><th>Credit / NLe</th></tr></thead><tbody>@foreach (var l in tradePreview.Lines) { <tr><td>@l.AccountCode</td><td>@Money(l.Debit)</td><td>@Money(l.Credit)</td></tr> }</tbody></table><button class="primary" disabled="@busy" @onclick="PostTrade">Post currency bank transaction</button> }</section>
    }
}
else if (tab == "Closing valuation")
{
    <section class="panel"><h2>Closing currency valuation</h2><p>Value open customer bills, supplier bills, uninvoiced foreign receipts and currency banks at the closing reference rate. Inventory stays at its recorded local cost. The closing journal is paired with an automatic reversal on the next day; this preserves the original bill allocation basis for later settlements. Cancel both through this screen, not a single journal reversal.</p><div class="form-grid"><label>Valuation date<input type="date" @bind="valuationDate" @bind:after="ClearValuation" /></label><label>Currency optional<select @bind="valuationCurrency" @bind:after="ClearValuation"><option value="">All open currencies</option>@foreach (var c in rates.Select(r => r.Currency).Distinct()) { <option value="@c">@c</option> }</select></label><label>Valuation reason<input maxlength="160" @bind="valuationReason" /></label></div><button class="secondary" disabled="@busy" @onclick="PreviewValuation">Review closing valuation</button>
    @if (valuationPreview is not null) { <p>Net valuation gain / loss NLe @Money(valuationPreview.NetGain)</p><div class="table-wrap"><table><thead><tr><th>Position</th><th>Currency</th><th>Units</th><th>Carrying</th><th>Closing rate</th><th>Closing value</th><th>Gain or loss</th></tr></thead><tbody>@foreach (var r in valuationPreview.Rows) { <tr><td>@r.Kind · @r.Number · @r.Party</td><td>@r.Currency</td><td>@Money(r.SourceBalance)</td><td>@Money(r.Carrying)</td><td>@r.ClosingRate</td><td>@Money(r.ClosingValue)</td><td>@Money(r.Gain)</td></tr> }</tbody></table></div>@if (CanWrite) { <button class="primary" disabled="@busy" @onclick="PostValuation">Post paired FX valuation</button> } }</section>
    <section class="panel"><h2>Valuation history</h2>@if (CanWrite) { <label>Cancellation reason<input maxlength="160" @bind="cancelReason" /></label> }<div class="table-wrap"><table><thead><tr><th>Number</th><th>Closing date</th><th>Automatic reversal date</th><th>Net gain</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var v in valuations) { <tr><td>@v.Number</td><td>@v.Date</td><td>@v.ReversedOn</td><td>@Money(v.NetGain)</td><td>@(v.Cancelled ? "Cancelled" : "Recorded")</td><td>@if (CanWrite && !v.Cancelled) { <button class="text-button" @onclick="() => CancelValuation(v)">Cancel paired valuation</button> }</td></tr> }</tbody></table></div></section>
}
else if (tab == "Exchange rates")
{
    <section class="panel"><h2>Dated reference rates</h2><p>Rates are NLe per one currency unit. Posted documents retain their own rates. Enter verified references; this screen does not download rates or connect to a bank.</p>@if (CanWrite) { <div class="form-grid"><label>Currency code<input maxlength="3" @bind="rateCurrency" /></label><label>Effective from<input type="date" @bind="rateFrom" /></label><label>NLe per currency unit<input type="number" min="0.0001" step="0.0001" @bind="newRate" /></label><label>Rate source<input maxlength="120" @bind="rateSource" /></label></div><button class="primary" disabled="@busy" @onclick="SaveRate">Save dated exchange rate</button> }<table><thead><tr><th>Currency</th><th>From</th><th>Rate</th><th>Source</th></tr></thead><tbody>@foreach (var r in rates) { <tr><td>@r.Currency</td><td>@r.EffectiveFrom</td><td>@r.Rate</td><td>@r.Source</td></tr> }</tbody></table></section>
}
@code {
    [Parameter] public Actor Actor { get; set; } = default!;
    private bool CanSell => Actor.Permissions.Contains("sales.create"); private bool CanAccount => Actor.Permissions.Contains("accounting.read"); private bool CanWrite => CanAccount && Actor.Permissions.Contains("accounting.write");
    private IEnumerable<string> Tabs => CanAccount ? new[] { "Foreign invoices", "Settlements", "Currency banks", "Closing valuation", "Exchange rates" } : new[] { "Foreign invoices", "Exchange rates" };
    private string tab = "Foreign invoices", error = "", message = ""; private bool busy;
    private BusinessSnapshot? snapshot; private IReadOnlyList<PartyView> parties = []; private IReadOnlyList<LocationView> locations = []; private IReadOnlyList<ExchangeRateView> rates = []; private IReadOnlyList<ForeignReceivableView> receivables = []; private IReadOnlyList<ForeignBillView> payables = []; private IReadOnlyList<ForeignBankView> banks = []; private IReadOnlyList<ForeignRevaluationView> valuations = []; private IReadOnlyList<LedgerDefinition> allAccounts = [], accounts = [];
    private string customer = "", currency = "", location = "MAIN", serial = "", batch = ""; private Guid product; private decimal quantity = 1, price, conversion = 1; private DateOnly invoiceDate = DateOnly.FromDateTime(DateTime.Today), due = DateOnly.FromDateTime(DateTime.Today).AddDays(7); private DateOnly? expiry; private readonly List<TradeLine> lines = []; private Guid invoiceOperation = Guid.NewGuid(); private DocumentDraftRecovery? recovery;
    private bool collect = true; private Guid billId, settlementOperation = Guid.NewGuid(); private int funds = 1000; private DateOnly settlementDate = DateOnly.FromDateTime(DateTime.Today); private decimal sourceAmount, localAmount; private string settlementReference = "";
    private DateOnly asAt = DateOnly.FromDateTime(DateTime.Today), tradeDate = DateOnly.FromDateTime(DateTime.Today); private int newBank, tradeBank, counter = 1000; private string bankCurrency = "", tradeReference = ""; private Guid bankOperation = Guid.NewGuid(), tradeOperation = Guid.NewGuid(); private ForeignBankTradeKind tradeKind; private decimal tradeSource, tradeLocal, targetSource; private ForeignBankTradePreview? tradePreview;
    private DateOnly valuationDate = DateOnly.FromDateTime(DateTime.Today); private string valuationCurrency = "", valuationReason = "", cancelReason = ""; private ForeignRevaluationPreview? valuationPreview; private Guid valuationOperation = Guid.NewGuid(), cancelOperation = Guid.NewGuid();
    private string rateCurrency = "", rateSource = ""; private DateOnly rateFrom = DateOnly.FromDateTime(DateTime.Today); private decimal newRate; private Guid rateOperation = Guid.NewGuid();
    private bool HasInvoice => customer.Length > 0 || product != Guid.Empty || lines.Count > 0 || quantity != 1 || price != 0 || serial.Length > 0 || batch.Length > 0 || expiry is not null;
    public bool HasDraft => HasInvoice || recovery?.HasRecovery == true || settlementReference.Length > 0 || sourceAmount != 0 || localAmount != 0 || tradeReference.Length > 0 || tradeSource != 0 || tradeLocal != 0 || valuationReason.Length > 0 || cancelReason.Length > 0 || rateSource.Length > 0 || newRate != 0;
    private sealed record SaleEditor(TradeCommand Request, Guid Product, decimal Quantity, decimal Price, decimal Conversion, string Serial, string Batch, DateOnly? Expiry);
    private TradeCommand Invoice() => new(invoiceOperation, DocumentKind.Sale, customer, invoiceDate, lines.ToList(), null, DueDate: due, Location: location, Currency: currency);
    private DocumentDraft RecoveryDraft => new("fxsales", invoiceOperation, System.Text.Json.JsonSerializer.Serialize(new SaleEditor(Invoice(), product, quantity, price, conversion, serial, batch, expiry)));
    public Task ClearRecovery() => CanSell && recovery is not null ? recovery.Clear() : Task.CompletedTask;
    private Task RestoreInvoice(DocumentDraft draft) { var saved = System.Text.Json.JsonSerializer.Deserialize<SaleEditor>(draft.Json) ?? throw new BusinessException("Invalid foreign invoice recovery."); var r = saved.Request; if (r is null || r.Lines is null || r.OperationId != draft.OperationId || r.Kind != DocumentKind.Sale || r.Payment is not null || r.Lines.Count > 200 || r.Lines.Any(l => !snapshot!.Products.Any(p => p.Id == l.ProductId))) throw new BusinessException("The recovered invoice does not match available products."); invoiceOperation = r.OperationId; customer = r.Party; invoiceDate = r.BusinessDate; due = r.DueDate ?? r.BusinessDate; currency = r.Currency ?? ""; location = r.Location; lines.Clear(); lines.AddRange(r.Lines); product = saved.Product; quantity = saved.Quantity; price = saved.Price; conversion = saved.Conversion; serial = saved.Serial; batch = saved.Batch; expiry = saved.Expiry; message = "Foreign invoice recovered. Review its source prices and dates before posting."; return Task.CompletedTask; }
    protected override Task OnInitializedAsync() => Run(Load);
    private async Task Load() { snapshot = await Business.Read(Actor); parties = await Parties.Read(); locations = await Inventory.Locations(); rates = await Purchasing.Rates(); if (CanAccount) { receivables = await Purchasing.ForeignReceivables(); payables = await Purchasing.ForeignBills(); banks = await Purchasing.ForeignBanks(asAt); valuations = await Purchasing.ForeignRevaluations(); allAccounts = (await Finance.Read(DateOnly.MinValue, DateOnly.FromDateTime(DateTime.Today))).Accounts; accounts = allAccounts.Where(a => a.CashOrBank).ToArray(); } }
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (ApprovalRequiredException e) { error = e.Message + " Review the request in Approvals."; } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException or JSException or System.Text.Json.JsonException) { error = e.Message; } catch { error = "Foreign exchange action could not complete. Check the register before retrying."; } finally { busy = false; } }
    private void Open(string t) { tab = t; error = message = ""; }
    private static string Money(decimal v) => v.ToString("N2");
    private void AddLine() { error = ""; if (product == Guid.Empty || quantity <= 0 || price <= 0 || conversion <= 0) { error = "Choose a product and positive source quantity price and conversion."; return; } if (lines.Count >= 200) { error = "An invoice has at most 200 lines."; return; } lines.Add(new(product, quantity, price, conversion, serial, batch, expiry)); product = Guid.Empty; quantity = conversion = 1; price = 0; serial = batch = ""; expiry = null; }
    private Task PostInvoice() => Run(async () => { if (string.IsNullOrWhiteSpace(currency)) throw new BusinessException("Choose a foreign invoice currency."); var id = await Business.Post(Actor, Invoice()); invoiceOperation = Guid.NewGuid(); customer = ""; lines.Clear(); product = Guid.Empty; quantity = conversion = 1; price = 0; serial = batch = ""; expiry = null; await Load(); message = "Foreign customer invoice posted: " + snapshot!.Documents.Single(d => d.Id == id).Number + ". Receive its payment from Settlements."; });
    private void ClearBill() { billId = Guid.Empty; sourceAmount = localAmount = 0; settlementReference = ""; settlementOperation = Guid.NewGuid(); }
    private string BillCurrency => collect ? receivables.SingleOrDefault(b => b.BillId == billId)?.Currency ?? "" : payables.SingleOrDefault(b => b.BillId == billId)?.Currency ?? "";
    private async Task PrepareBill() { sourceAmount = collect ? receivables.SingleOrDefault(b => b.BillId == billId)?.SourceOutstanding ?? 0 : payables.SingleOrDefault(b => b.BillId == billId)?.SourceOutstanding ?? 0; settlementOperation = Guid.NewGuid(); await Reprice(); }
    private Task Reprice() => Run(async () => { if (billId == Guid.Empty) return; var currentBanks = await Purchasing.ForeignBanks(settlementDate); var bank = currentBanks.SingleOrDefault(b => b.AccountCode == funds); var rate = rates.Where(r => r.Currency == BillCurrency && r.EffectiveFrom <= settlementDate).OrderByDescending(r => r.EffectiveFrom).FirstOrDefault()?.Rate ?? 0; localAmount = bank is not null && !collect && bank.SourceBalance > 0 ? sourceAmount == bank.SourceBalance ? bank.LocalCarrying : AccountingEngine.Money(bank.LocalCarrying * sourceAmount / bank.SourceBalance) : AccountingEngine.Money(sourceAmount * rate); });
    private Task Settle() => Run(async () => { if (collect) await Purchasing.CollectForeign(new(settlementOperation, billId, settlementDate, sourceAmount, localAmount, funds, settlementReference)); else await Purchasing.PayForeign(new(settlementOperation, billId, settlementDate, sourceAmount, localAmount, funds, settlementReference)); ClearBill(); await Load(); message = "Foreign settlement posted with its exchange difference."; });
    private Task RefreshBanks() => Run(async () => banks = await Purchasing.ForeignBanks(asAt));
    private Task ConfigureBank() => Run(async () => { await Purchasing.ConfigureForeignBank(new(bankOperation, newBank, bankCurrency)); bankOperation = Guid.NewGuid(); newBank = 0; bankCurrency = ""; await Load(); message = "Currency bank assigned. Its currency is fixed."; });
    private void ClearTrade() => tradePreview = null;
    private ForeignBankTradeCommand Trade() => new(tradeOperation, tradeKind, tradeDate, tradeBank, counter, tradeSource, tradeLocal, targetSource, tradeReference, tradePreview?.CalculationFingerprint);
    private Task PreviewTrade() => Run(async () => tradePreview = await Purchasing.PreviewForeignBankTrade(Trade()));
    private Task PostTrade() => Run(async () => { await Purchasing.PostForeignBankTrade(Trade()); tradeOperation = Guid.NewGuid(); tradeSource = tradeLocal = targetSource = 0; tradeReference = ""; tradePreview = null; await Load(); message = "Currency bank transaction posted."; });
    private void ClearValuation() => valuationPreview = null;
    private Task PreviewValuation() => Run(async () => valuationPreview = await Purchasing.PreviewForeignRevaluation(new(valuationDate, valuationCurrency.Length == 0 ? [] : [valuationCurrency])));
    private Task PostValuation() => Run(async () => { if (valuationPreview is null) throw new BusinessException("Review valuation first."); await Purchasing.PostForeignRevaluation(new(valuationOperation, valuationPreview.Request, valuationPreview.CalculationFingerprint, valuationReason)); valuationOperation = Guid.NewGuid(); valuationPreview = null; valuationReason = ""; await Load(); message = "Closing valuation and next-day reversal posted together."; });
    private Task CancelValuation(ForeignRevaluationView v) => Run(async () => { await Purchasing.CancelForeignRevaluation(new(cancelOperation, v.Id, cancelReason)); cancelOperation = Guid.NewGuid(); cancelReason = ""; await Load(); message = "Both valuation journals cancelled; audit history retained."; });
    private Task SaveRate() => Run(async () => { await Purchasing.SetRate(new(rateOperation, rateCurrency, rateFrom, newRate, rateSource)); rateOperation = Guid.NewGuid(); rateCurrency = rateSource = ""; newRate = 0; await Load(); message = "Dated exchange rate saved."; });
}
