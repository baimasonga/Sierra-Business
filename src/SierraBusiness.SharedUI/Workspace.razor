    private RenderFragment DocumentTable(IEnumerable<DocumentView> docs) => @<div class="table-wrap"><table><thead><tr><th>Document</th><th>Customer / supplier</th><th>Date</th><th>Settlement</th><th class="numeric">Amount / NLe</th></tr></thead><tbody>@foreach (var d in docs) { <tr><td><button class="text-button" @onclick='() => SelectDocument(d)'>@d.Kind · @d.Number[^8..]</button></td><td>@d.Party</td><td>@d.BusinessDate.ToString("dd MMM yyyy")</td><td><span class="pill">@d.Settlement</span></td><td class="numeric">@d.Total.ToString("N2")</td></tr> }</tbody></table>@if (!docs.Any()) { <p class="empty">No documents yet. Receive your opening stock to get started.</p> }</div>;
