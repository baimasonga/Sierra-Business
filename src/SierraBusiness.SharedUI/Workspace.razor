    private async Task HandleKey(KeyboardEventArgs args) { if (!busy && page == "New sale" && args.AltKey) { if (args.Key.Equals("b", StringComparison.OrdinalIgnoreCase)) await scanInput.FocusAsync(); if (args.Key.Equals("k", StringComparison.OrdinalIgnoreCase)) await productSearchInput.FocusAsync(); if (args.Key.Equals("h", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(holdLabel)) await Hold(); } if (args.AltKey && args.Key.Equals("n", StringComparison.OrdinalIgnoreCase)) await Navigate("New sale"); if (args.AltKey && args.Key.Equals("r", StringComparison.OrdinalIgnoreCase)) await Navigate("Receive stock"); if (args.Key == "Escape") { selectedDocument = null; error = ""; } }
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = ""; try { await action(); } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException) { error = e.Message; } catch (Exception) { error = "The operation could not complete. Refresh and check the document register before retrying."; } finally { busy = false; } }
    private Task CreateProduct() => Run(async () => { await Business.AddProduct(Actor, new(operationId, sku, name, category, unit, price, tracking)); operationId = Guid.NewGuid(); sku = name = ""; data = await Business.Read(Actor); success = "Product saved. An authorized manager must configure its confidential minimum under Sales controls before it can be quoted or sold."; });
    private void AddLine() { if (busy) return; error = ""; var p = data?.Products.SingleOrDefault(x => x.Id == selectedProduct); if (p is null) { error = "Select a product first."; return; } if (quantity <= 0 || conversion <= 0) { error = "Quantity and conversion must be positive."; return; } if (linePrice < 0 || (page == "Receive stock" && linePrice <= 0)) { error = "Enter a positive receipt cost; negative prices are not allowed."; return; } lines.Add(new(p.Id, quantity, linePrice > 0 ? linePrice : p.Price * conversion, conversion, serial, batch, expiry)); ResetLineEntry(); }
    private Task AddEarliestBatches() => Run(async () =>
    {
        if (page != "New sale") throw new BusinessException("Batch suggestions are available for counter sales.");
        var product = data?.Products.SingleOrDefault(x => x.Id == selectedProduct) ?? throw new BusinessException("Select a product first.");
        if (conversion != 1) throw new BusinessException("Use base units (conversion 1) for batch suggestions.");
        if (!string.IsNullOrWhiteSpace(serial) || !string.IsNullOrWhiteSpace(batch) || expiry is not null) throw new BusinessException("Clear the manual tracking details before requesting batch suggestions, or use Add line.");
        if (linePrice < 0) throw new BusinessException("Agreed price cannot be negative.");
        var price = linePrice > 0 ? linePrice : product.Price; Rules.Positive(price, "Agreed base-unit price");
        var request = new BatchSuggestionCommand(product.Id, location, businessDate, quantity,
            lines.Where(x => x.ProductId == product.Id).Select(x => new BatchPick(x.Batch ?? "", x.Expiry, x.Quantity * x.Conversion)).ToList());
        var picks = await Inventory.SuggestBatches(request);
        if (lines.Count + picks.Count > 200) throw new BusinessException("These suggestions would exceed 200 document lines. Split the sale; no lines were added.");
        lines.AddRange(picks.Select(x => new TradeLine(product.Id, x.Quantity, price, 1, Batch: x.Batch, Expiry: x.Expiry)));
        ResetLineEntry(); success = $"Added {picks.Count} batch lines to the draft. Review quantities, prices and expiry dates before posting.";
    });
    private Task PostDocument() => Run(async () => { var kind = page == "New sale" ? DocumentKind.Sale : DocumentKind.Receipt; var payment = kind == DocumentKind.Receipt || settlement == "Credit" ? (PaymentMethod?)null : Enum.Parse<PaymentMethod>(settlement); var id = await Business.Post(Actor, new(operationId, kind, party, businessDate, [..lines], payment, paymentReference, bank, paymentDate, dueDate, Location: location, HeldSaleId: heldSaleId, Currency: kind == DocumentKind.Receipt && receiptCurrency.Length > 0 ? receiptCurrency : null, InvoiceLater: kind == DocumentKind.Receipt && invoiceLater)); heldSaleId = null; invoiceLater = false; holdLabel = ""; operationId = Guid.NewGuid(); lines.Clear(); data = await Business.Read(Actor); page = "Documents"; selectedDocument = data.Documents.Single(x => x.Id == id); success = "Document posted. Stock, accounting and audit records committed together."; });
    private Task ReverseDocument() => Run(async () => { if (!confirmReversal || selectedDocument is null) return; await Business.Reverse(Actor, new(operationId, selectedDocument.Id, reason)); operationId = Guid.NewGuid(); confirmReversal = false; reason = ""; data = await Business.Read(Actor); selectedDocument = null; success = "Reversal posted. The original record is preserved."; });
