    private Task ApplyPriceRules() => Run(async () =>
    {
        if (Services.GetService(typeof(IPricingService)) is not IPricingService pricing) return;
        var quotes = await pricing.Quote(party, businessDate, [..lines]); var changed = 0;
        foreach (var q in quotes) { var l = lines[q.Line]; if (l.UnitPrice == 0 || l.UnitPrice > q.Price) { lines[q.Line] = l with { UnitPrice = q.Price }; changed++; } }
        success = changed == 0 ? "No price rule gives a lower price for these lines." : $"{changed} line(s) priced by price rules: " + string.Join(", ", quotes.Select(x => x.Rule).Distinct()) + ".";
    });
