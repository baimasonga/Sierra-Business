    private async Task Navigate(string target)
    {
        if (busy || target == page || !await MayLeave()) return;
        var refreshAfterModule = page is "Import from Excel" or "Imports & landed cost" or "Supplier invoices" or "Installations" or "Service jobs" or "Tenders" or "Product settings" or "Count sessions" or "Barcodes" or "Banking" or "Tills" or "Sales controls" or "Accounting" or "Orders & quotations" or "Warehouse controls" or "Payroll" or "Customers & suppliers" or "Returns";
        heldSaleId = null; holdLabel = productSearch = scanCode = "";
        menuOpen = false; page = target; error = success = ""; selectedDocument = null;
        lines.Clear(); selectedProduct = Guid.Empty; ResetLineEntry();
        operationId = Guid.NewGuid(); party = target == "New sale" ? "Walk-in" : ""; invoiceLater = false;
        settlement = "Cash"; paymentReference = bank = "";
        businessDate = DateOnly.FromDateTime(DateTime.UtcNow); paymentDate = businessDate; dueDate = null;
        if (target == "New sale") await Run(LoadPos);
        if (target == "Receive stock" && Purchasing is not null) await Run(async () => currencies = (await Purchasing.Rates()).Select(x => x.Currency).Distinct().ToList()); // rates added since sign-in
        if (refreshAfterModule && data is not null) await Run(async () => { data = await Business.Read(Actor); locations = await Inventory.Locations(); parties = await Parties.Read(); inventorySettings = await InventoryManagement.Products(); });
    }
    private void ResetLineEntry() { linePrice = 0; quantity = 1; var settings = inventorySettings.FirstOrDefault(x => x.ProductId == selectedProduct); conversion = page == "Receive stock" ? settings?.PurchaseConversion ?? 1 : settings?.SalesConversion ?? 1; serial = batch = ""; expiry = null; }
