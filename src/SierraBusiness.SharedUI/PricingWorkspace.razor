@inject IPricingService Pricing
@inject IBusinessService Business
@inject IPartyService Parties
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
<section class="panel"><div class="panel-title"><h2>Price rules and promotions</h2></div>
    <p class="hint">A rule lowers the price of a product (or a whole category) for a period, optionally only for one type of customer and from a minimum quantity. On New sale, <strong>Apply price rules</strong> uses the best price; prices at or above it need no discount approval or minimum-price check.</p>
    <div class="table-wrap"><table><thead><tr><th>Rule</th><th>Applies to</th><th>Customers</th><th>From qty</th><th>Price</th><th>Dates</th><th>Status</th><th></th></tr></thead>
        <tbody>@foreach (var r in rules) { <tr><td>@r.Code · @r.Name</td><td>@r.ProductLabel</td><td>@(r.CustomerCategory.Length > 0 ? r.CustomerCategory : "All")</td><td>@(r.MinQuantity > 0 ? r.MinQuantity.ToString("0.##") : "Any")</td>
            <td>@(r.Kind == PriceRuleKind.PercentOff ? $"{r.Value:0.##}% off" : $"NLe {r.Value:N2}")</td><td>@r.From.ToString("dd MMM yyyy")@(r.To is DateOnly t ? $" – {t:dd MMM yyyy}" : " onward")</td><td>@(r.Active ? "Active" : "Off")</td>
            <td>@if (CanPrice) { <button class="text-button" @onclick="() => Edit(r)">Edit</button> }</td></tr> }</tbody></table></div>
    @if (rules.Count == 0) { <p class="hint">No price rules yet.</p> }
</section>
@if (CanPrice)
{
    <section class="panel"><h2>@(id is null ? "New price rule" : "Edit price rule")</h2>
        <div class="form-grid">
            <label>Code<input maxlength="30" @bind="code" /></label><label>Name<input maxlength="120" @bind="name" /></label>
            <label>Type<select @bind="kind"><option value="@PriceRuleKind.PercentOff">Percentage off list price</option><option value="@PriceRuleKind.FixedPrice">Fixed price (one product)</option></select></label>
            <label>@(kind == PriceRuleKind.PercentOff ? "Percentage off" : "Price per base unit")<input type="number" min="0" step="0.01" @bind="value" /></label>
            <label>Product<select @bind="productId"><option value="@Guid.Empty">Any product (or a category)</option>@foreach (var p in products) { <option value="@p.Id">@p.Sku · @p.Name (@p.Price.ToString("N2"))</option> }</select></label>
            @if (productId == Guid.Empty) { <label>Product category (blank = all)<input list="product-categories" @bind="category" /></label> }
            <label>Customer type (blank = all)<input list="customer-types" @bind="customerCategory" /></label>
            <label>From quantity<input type="number" min="0" step="1" @bind="minQuantity" /></label>
            <label>From<input type="date" @bind="from" /></label><label>Until (optional)<input type="date" @bind="to" /></label>
            <label class="check"><input type="checkbox" @bind="active" /> Active</label>
        </div>
        <datalist id="product-categories">@foreach (var c in products.Select(p => p.Category).Distinct().OrderBy(x => x)) { <option value="@c"></option> }</datalist>
        <datalist id="customer-types">@foreach (var c in PartyCategories.Suggested.Concat(customerTypes).Distinct()) { <option value="@c"></option> }</datalist>
        <button class="primary" disabled="@busy" @onclick="Save">Save rule</button> <button class="secondary" @onclick="Clear">New</button>
    </section>
}
@code {
    [Parameter, EditorRequired] public Actor Actor { get; set; } = default!;
    private IReadOnlyList<PriceRuleView> rules = []; private IReadOnlyList<ProductView> products = []; private IReadOnlyList<string> customerTypes = [];
    private bool busy, active = true; private string error = "", message = "", code = "", name = "", category = "", customerCategory = "";
    private Guid? id; private int version; private PriceRuleKind kind; private decimal value, minQuantity; private Guid productId; private DateOnly from = DateOnly.FromDateTime(DateTime.Now); private DateOnly? to;
    private Guid operation = Guid.NewGuid();
    private bool CanPrice => Actor.Permissions.Contains("pricing.manage");
    protected override Task OnInitializedAsync() => Run(async () => { await Load(); products = (await Business.Read(Actor)).Products; customerTypes = (await Parties.Read()).Select(x => x.Category).Where(x => x.Length > 0).Distinct().ToList(); });
    private async Task Load() => rules = await Pricing.Rules();
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } catch (Exception) { error = "The action could not complete. Refresh and try again."; } finally { busy = false; } }
    private void Edit(PriceRuleView r) { id = r.Id; version = r.Version; code = r.Code; name = r.Name; kind = r.Kind; value = r.Value; productId = r.ProductId ?? Guid.Empty; category = r.Category; customerCategory = r.CustomerCategory; minQuantity = r.MinQuantity; from = r.From; to = r.To; active = r.Active; operation = Guid.NewGuid(); }
    private void Clear() { id = null; version = 0; code = name = category = customerCategory = ""; kind = PriceRuleKind.PercentOff; value = minQuantity = 0; productId = Guid.Empty; from = DateOnly.FromDateTime(DateTime.Now); to = null; active = true; operation = Guid.NewGuid(); }
    private Task Save() => Run(async () => { await Pricing.Save(new(operation, id, version, code, name, kind, value, productId == Guid.Empty ? null : productId, category, customerCategory, minQuantity, from, to, active)); message = $"Rule {code.ToUpperInvariant()} saved."; Clear(); await Load(); });
}
