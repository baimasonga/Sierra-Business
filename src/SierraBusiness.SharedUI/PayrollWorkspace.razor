@inject IPayrollService Payroll
@inject Microsoft.JSInterop.IJSRuntime JS
<section class="panel"><div class="panel-title"><h2>Employees and monthly payroll</h2><button class="secondary" disabled="@busy" @onclick="Refresh">Refresh</button></div><p>Fixed monthly salary, allowances and entered deductions. Payroll posts salary expense, net wages payable and deductions payable. Statutory deductions are not calculated automatically.</p></section>
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
<section class="panel"><h2>@(employeeId is null ? "New employee" : "Edit employee")</h2><div class="form-grid"><label>Employee code<input @bind="code" maxlength="40" /></label><label>Name<input @bind="name" maxlength="160" /></label><label>Department / cost centre<input @bind="department" maxlength="100" /></label><label>Basic monthly salary (NLe)<input type="number" min="0" step="0.01" @bind="basic" /></label><label>Monthly allowances<input type="number" min="0" step="0.01" @bind="allowances" /></label><label>Monthly deductions<input type="number" min="0" step="0.01" @bind="deductions" /></label><label>Employment start<input type="date" @bind="start" /></label><label>Employment end (optional)<input type="date" @bind="end" /></label></div><button class="primary" disabled="@busy" @onclick="Save">Save employee</button> <button class="secondary" disabled="@busy" @onclick="New">New employee</button></section>
<section class="panel"><h2>Run payroll</h2><div class="form-grid"><label>Any date in payroll month<input type="date" @bind="month" /></label><label>Posting date (month-end or later)<input type="date" @bind="postingDate" /></label></div><p class="hint">Select full-month employees. Joining/leaving part-way through a month needs a separate proration workflow. Editing an employee never changes previously posted payslips.</p><table><thead><tr><th>Select</th><th>Code / name</th><th>Department</th><th>Gross</th><th>Deductions</th><th>Net</th><th></th></tr></thead><tbody>@foreach (var e in data.Employees) { <tr><td><input type="checkbox" aria-label="Select @e.Name for payroll" checked="@selected.Contains(e.Id)" @onchange="args => Choose(e.Id, args)" /></td><td>@e.Code · @e.Name</td><td>@e.Department</td><td>@((e.BasicSalary + e.Allowances).ToString("N2"))</td><td>@e.Deductions.ToString("N2")</td><td>@((e.BasicSalary + e.Allowances - e.Deductions).ToString("N2"))</td><td><button class="text-button" disabled="@busy" @onclick="() => Edit(e)">Edit</button></td></tr> }</tbody></table><p>Selected gross @Gross.ToString("N2") · deductions @DeductionTotal.ToString("N2") · net @((Gross - DeductionTotal).ToString("N2")) NLe.</p><button class="primary" disabled="@(busy || selected.Count == 0)" @onclick="Post">Post monthly payroll</button></section>
<section class="panel"><h2>Payroll register and payslips</h2><p class="hint">Net wages and deductions remain payable until recorded as payments through Accounting. This register does not allocate individual employee payments.</p><table><thead><tr><th>Month</th><th>Employee</th><th>Gross</th><th>Deductions</th><th>Net</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var slip in data.Payslips) { <tr><td>@slip.Month.ToString("yyyy-MM")</td><td>@slip.EmployeeCode · @slip.EmployeeName</td><td>@((slip.Basic + slip.Allowances).ToString("N2"))</td><td>@slip.Deductions.ToString("N2")</td><td>@slip.Net.ToString("N2")</td><td>@(slip.Reversed ? "Reversed" : "Posted")</td><td><button class="text-button" @onclick="() => payslip = slip">View payslip</button></td></tr> }</tbody></table></section>
@if (payslip is not null) { <PrintButton Target="payslip-print" /><section class="panel" id="payslip-print"><h2>Payslip · @payslip.Month.ToString("MMMM yyyy")</h2><p>@payslip.EmployeeCode · @payslip.EmployeeName<br />@payslip.Department</p><p class="code">@payslip.Number</p><table><tbody><tr><th>Basic salary</th><td>@payslip.Basic.ToString("N2")</td></tr><tr><th>Allowances</th><td>@payslip.Allowances.ToString("N2")</td></tr><tr><th>Deductions</th><td>@payslip.Deductions.ToString("N2")</td></tr><tr><th>Net pay / NLe</th><td>@payslip.Net.ToString("N2")</td></tr></tbody></table><p>@(payslip.Reversed ? "REVERSED — not a current payroll entitlement" : "Posted payroll entitlement; not proof of payment.")</p></section> }
@code {
    private PayrollSnapshot data = new([], []);
    private bool busy;
    private string error = "", message = "", code = "", name = "", department = "";
    private Guid? employeeId;
    private Guid employeeOperation = Guid.NewGuid(), payrollOperation = Guid.NewGuid();
    private int version;
    private decimal basic, allowances, deductions;
    private DateOnly start = DateOnly.FromDateTime(DateTime.UtcNow), month = DateOnly.FromDateTime(DateTime.UtcNow).AddMonths(-1), postingDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private DateOnly? end;
    private readonly HashSet<Guid> selected = [];
    private PayslipView? payslip;
    public bool HasDraft => code.Length > 0 || name.Length > 0 || department.Length > 0 || selected.Count > 0;
    private decimal Gross => data.Employees.Where(x => selected.Contains(x.Id)).Sum(x => x.BasicSalary + x.Allowances);
    private decimal DeductionTotal => data.Employees.Where(x => selected.Contains(x.Id)).Sum(x => x.Deductions);
    protected override Task OnInitializedAsync() => Refresh();
    private Task Refresh() => Run(async () => data = await Payroll.Read());
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } catch (Exception) { error = "Payroll could not complete. Check the register before retrying."; } finally { busy = false; } }
    private void Choose(Guid id, ChangeEventArgs args) { if (args.Value is true) selected.Add(id); else selected.Remove(id); }
    private async Task Edit(EmployeeView e) { if (code.Length > 0 && !await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<bool>(JS, "confirm", "Discard unsaved employee changes?")) return; employeeId = e.Id; version = e.Version; code = e.Code; name = e.Name; department = e.Department; basic = e.BasicSalary; allowances = e.Allowances; deductions = e.Deductions; start = e.StartDate; end = e.EndDate; employeeOperation = Guid.NewGuid(); }
    private void Clear() { employeeId = null; version = 0; code = name = department = ""; basic = allowances = deductions = 0; end = null; employeeOperation = Guid.NewGuid(); }
    private async Task New() { if (code.Length == 0 || await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<bool>(JS, "confirm", "Discard unsaved employee changes?")) Clear(); }
    private Task Save() => Run(async () => { await Payroll.SaveEmployee(new(employeeOperation, employeeId, version, code, name, department, basic, allowances, deductions, start, end)); Clear(); data = await Payroll.Read(); message = "Employee saved. Earlier payslips are unchanged."; });
    private Task Post() => Run(async () => { await Payroll.Post(new(payrollOperation, month, postingDate, selected.ToList())); payrollOperation = Guid.NewGuid(); selected.Clear(); data = await Payroll.Read(); message = "Payroll posted with employee snapshots and a balanced journal."; });
}

