@inject IPayrollService Payroll
@inject IServiceProvider Services
@inject Microsoft.JSInterop.IJSRuntime JS
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }

<div class="view-toggle report-tabs" role="tablist">
    @foreach (var t in new[] { "Employees", "Run payroll", "Payslips & payments", "Loans", "PAYE & NASSIT" }) { <button type="button" role="tab" class="@(tab == t ? "active" : "")" aria-selected="@(tab == t)" @onclick="() => Open(t)">@t</button> }
</div>
@if (rules is null && tab != "PAYE & NASSIT") { <div class="notice" role="note">Statutory deductions are off. Set the PAYE and NASSIT rules on the <button class="text-button" @onclick='() => Open("PAYE & NASSIT")'>PAYE &amp; NASSIT</button> tab to calculate them automatically.</div> }

@if (tab == "Employees")
{
    <section class="panel"><h2>@(employeeId is null ? "New employee" : "Edit employee")</h2>
        <div class="form-grid">
            <label>Employee code<input @bind="code" maxlength="40" /></label><label>Name<input @bind="name" maxlength="160" /></label><label>Department / cost centre<input @bind="department" maxlength="100" /></label>
            <label>Basic monthly salary (NLe)<input type="number" min="0" step="0.01" @bind="basic" /></label><label>Monthly allowances<input type="number" min="0" step="0.01" @bind="allowances" /></label><label>Other monthly deductions (after tax)<input type="number" min="0" step="0.01" @bind="deductions" /></label>
            <label>Employment start<input type="date" @bind="start" /></label><label>Employment end (optional)<input type="date" @bind="end" /></label>
            <label>TIN<input @bind="tin" maxlength="30" /></label><label>NASSIT number<input @bind="nassitNumber" maxlength="30" /></label><label>Date of birth (optional)<input type="date" @bind="birthDate" /></label>
            <label>Bank (for salary transfers)<input @bind="bankName" maxlength="80" /></label><label>Bank account number<input @bind="bankAccount" maxlength="40" /></label>
            <label class="check"><input type="checkbox" @bind="resident" /> Resident for tax</label><label class="check"><input type="checkbox" @bind="nassitExempt" /> Not a NASSIT contributor</label>
        </div>
        <button class="primary" disabled="@busy" @onclick="Save">Save employee</button> <button class="secondary" disabled="@busy" @onclick="New">New employee</button>
    </section>
    <section class="panel"><h2>Employees</h2>
        <div class="table-wrap"><table><thead><tr><th>Code / name</th><th>Department</th><th class="numeric">Basic</th><th class="numeric">Allowances</th><th class="numeric">Other deductions</th><th>TIN / NASSIT</th><th>Employed</th><th></th></tr></thead>
        <tbody>@foreach (var e in data.Employees) { <tr><td>@e.Code · @e.Name</td><td>@e.Department</td><td class="numeric">@e.BasicSalary.ToString("N2")</td><td class="numeric">@e.Allowances.ToString("N2")</td><td class="numeric">@e.Deductions.ToString("N2")</td><td>@(e.Tin.Length > 0 ? e.Tin : "—") / @(e.NassitNumber.Length > 0 ? e.NassitNumber : "—")@(e.Resident ? "" : " · non-resident")@(e.NassitExempt ? " · no NASSIT" : "")</td><td>@e.StartDate.ToString("dd MMM yyyy")@(e.EndDate is DateOnly x ? $" – {x:dd MMM yyyy}" : "")</td><td><button class="text-button" disabled="@busy" @onclick="() => Edit(e)">Edit</button></td></tr> }</tbody></table></div>
    </section>
}
else if (tab == "Run payroll")
{
    <section class="panel"><h2>Run payroll</h2>
        <div class="form-grid"><label>Payroll month<input type="month" @bind="MonthText" /></label><label>Posting date (month-end or later)<input type="date" @bind="postingDate" /></label></div>
        <p class="hint">Employees who joined or left during the month are paid for the days employed. Enter unpaid days, overtime, bonus or a one-off deduction for this month only. Editing an employee never changes payslips already posted.</p>
        <div class="table-wrap"><table><thead><tr><th><input type="checkbox" aria-label="Select all employees" checked="@(data.Employees.Count > 0 && selected.Count == Eligible.Count())" @onchange="ChooseAll" /></th><th>Employee</th><th>Unpaid days</th><th>Overtime</th><th>Bonus</th><th>One-off deduction</th><th>Leave allowance</th><th>End of service</th><th>Skip loan</th><th>Note</th></tr></thead>
        <tbody>@foreach (var e in Eligible) { var adj = Adjustment(e.Id); <tr><td><input type="checkbox" aria-label="Select @e.Name for payroll" checked="@selected.Contains(e.Id)" @onchange="args => Choose(e.Id, args)" /></td><td>@e.Code · @e.Name</td>
            <td><input class="num" type="number" min="0" step="0.5" value="@adj.UnpaidDays" @onchange="v => Adjust(e.Id, a => a with { UnpaidDays = Num(v) })" /></td>
            <td><input class="num" type="number" min="0" step="0.01" value="@adj.Overtime" @onchange="v => Adjust(e.Id, a => a with { Overtime = Num(v) })" /></td>
            <td><input class="num" type="number" min="0" step="0.01" value="@adj.Bonus" @onchange="v => Adjust(e.Id, a => a with { Bonus = Num(v) })" /></td>
            <td><input class="num" type="number" min="0" step="0.01" value="@adj.ExtraDeduction" @onchange="v => Adjust(e.Id, a => a with { ExtraDeduction = Num(v) })" /></td>
            <td><input class="num" type="number" min="0" step="0.01" value="@adj.LeaveAllowance" @onchange="v => Adjust(e.Id, a => a with { LeaveAllowance = Num(v) })" /></td>
            <td><input class="num" type="number" min="0" step="0.01" value="@adj.EndOfService" @onchange="v => Adjust(e.Id, a => a with { EndOfService = Num(v) })" /></td>
            <td><input type="checkbox" aria-label="Skip loan instalment for @e.Name" checked="@adj.SkipLoan" @onchange="v => Adjust(e.Id, a => a with { SkipLoan = v.Value is true })" /></td>
            <td><input maxlength="100" value="@adj.Note" @onchange="v => Adjust(e.Id, a => a with { Note = v.Value?.ToString() ?? string.Empty })" /></td></tr> }</tbody></table></div>
        <button class="secondary" disabled="@(busy || selected.Count == 0)" @onclick="PreviewRun">Calculate</button>
        @if (preview is { } p)
        {
            <p class="hint">@p.RulesNote</p>
            <div class="table-wrap"><table class="report-table"><thead><tr><th>Employee</th><th class="numeric">Days</th><th class="numeric">Gross</th><th class="numeric">NASSIT 5%</th><th class="numeric">Chargeable</th><th class="numeric">PAYE</th><th class="numeric">Other</th><th class="numeric">Loan</th><th class="numeric">Net pay</th><th class="numeric">Employer NASSIT</th></tr></thead>
                <tbody>@foreach (var l in p.Lines) { var c = l.Calculation; <tr><td>@l.Code · @l.Name</td><td class="numeric">@c.DaysPaid.ToString("0.#")/@c.DaysInMonth</td><td class="numeric">@c.Gross.ToString("N2")</td><td class="numeric">@c.NassitEmployee.ToString("N2")</td><td class="numeric">@c.Chargeable.ToString("N2")</td><td class="numeric">@c.Paye.ToString("N2")</td><td class="numeric">@c.OtherDeductions.ToString("N2")</td><td class="numeric">@c.LoanRepayment.ToString("N2")</td><td class="numeric"><strong>@c.Net.ToString("N2")</strong></td><td class="numeric">@c.NassitEmployer.ToString("N2")</td></tr> }</tbody>
                <tfoot><tr><th>Total</th><td></td><td class="numeric">@p.Gross.ToString("N2")</td><td class="numeric">@p.NassitEmployee.ToString("N2")</td><td></td><td class="numeric">@p.Paye.ToString("N2")</td><td class="numeric">@p.OtherDeductions.ToString("N2")</td><td class="numeric">@p.Lines.Sum(x => x.Calculation.LoanRepayment).ToString("N2")</td><td class="numeric"><strong>@p.Net.ToString("N2")</strong></td><td class="numeric">@p.NassitEmployer.ToString("N2")</td></tr></tfoot></table></div>
            <button class="primary" disabled="@busy" @onclick="Post">Post payroll for @p.Month.ToString("MMMM yyyy")</button>
        }
    </section>
}
else if (tab == "Payslips & payments")
{
    <section class="panel"><h2>Payslips</h2>
        <div class="report-period"><label>Month<select @bind="slipMonth">@foreach (var m in Months) { <option value="@m.ToString("yyyy-MM")">@m.ToString("MMMM yyyy")</option> }</select></label></div>
        <div class="table-wrap"><table><thead><tr><th><input type="checkbox" aria-label="Select all unpaid payslips" checked="@(toPay.Count > 0 && toPay.Count == Unpaid.Count())" @onchange="ChooseAllUnpaid" /></th><th>Employee</th><th class="numeric">Gross</th><th class="numeric">PAYE</th><th class="numeric">NASSIT</th><th class="numeric">Other</th><th class="numeric">Net</th><th>Status</th><th></th></tr></thead>
        <tbody>@foreach (var s in MonthSlips) { var c = s.Calculation!; <tr><td>@if (!s.Reversed && !s.Paid) { <input type="checkbox" aria-label="Pay @s.EmployeeName" checked="@toPay.Contains(s.ItemId)" @onchange="args => ChoosePay(s.ItemId, args)" /> }</td><td>@s.EmployeeCode · @s.EmployeeName</td><td class="numeric">@c.Gross.ToString("N2")</td><td class="numeric">@c.Paye.ToString("N2")</td><td class="numeric">@c.NassitEmployee.ToString("N2")</td><td class="numeric">@c.OtherDeductions.ToString("N2")</td><td class="numeric">@s.Net.ToString("N2")</td><td>@(s.Reversed ? "Reversed" : s.Paid ? $"Paid {s.PaidOn:dd MMM} ({s.PaymentNumber})" : "Unpaid")</td><td><button class="text-button" @onclick="() => payslip = s">Payslip</button></td></tr> }</tbody></table></div>
        @if (Unpaid.Any())
        {
            <h3>Pay selected salaries</h3>
            <div class="form-grid"><label>Payment date<input type="date" @bind="payDate" /></label><label>Paid by<select @bind="payMethod"><option value="@PaymentMethod.BankTransfer">Bank transfer</option><option value="@PaymentMethod.Cash">Cash</option></select></label><label>Transfer reference<input maxlength="100" @bind="payReference" /></label></div>
            <button class="secondary" disabled="@(busy || toPay.Count == 0)" @onclick="DownloadBankFile">Bank transfer file</button> <button class="primary" disabled="@(busy || toPay.Count == 0)" @onclick="PaySelected">Pay @toPay.Count salar@(toPay.Count == 1 ? "y" : "ies") · NLe @MonthSlips.Where(x => toPay.Contains(x.ItemId)).Sum(x => x.Net).ToString("N2")</button>
        }
    </section>
    @if (payslip is { } ps && ps.Calculation is { } pc)
    {
        <PrintButton Target="payslip-print" />
        <section class="panel printable" id="payslip-print">
            <DocumentLetterhead Setup="printSetup" CompanyName="@CompanyName" Title="@($"Payslip · {ps.Month:MMMM yyyy}")" Number="@ps.Number" />
            <p><strong>@ps.EmployeeCode · @ps.EmployeeName</strong> · @ps.Department<br />TIN: @(ps.Tin.Length > 0 ? ps.Tin : "—") · NASSIT: @(ps.NassitNumber.Length > 0 ? ps.NassitNumber : "—") · Days paid: @pc.DaysPaid.ToString("0.#") of @pc.DaysInMonth</p>
            <table><thead><tr><th>Earnings</th><th class="numeric">NLe</th><th>Deductions</th><th class="numeric">NLe</th></tr></thead>
                <tbody>
                    <tr><td>Basic salary</td><td class="numeric">@pc.Basic.ToString("N2")</td><td>PAYE</td><td class="numeric">@pc.Paye.ToString("N2")</td></tr>
                    <tr><td>Allowances</td><td class="numeric">@pc.Allowances.ToString("N2")</td><td>NASSIT (employee)</td><td class="numeric">@pc.NassitEmployee.ToString("N2")</td></tr>
                    <tr><td>Overtime</td><td class="numeric">@pc.Overtime.ToString("N2")</td><td>Other deductions@(pc.Note.Length > 0 ? $" ({pc.Note})" : "")</td><td class="numeric">@pc.OtherDeductions.ToString("N2")</td></tr>
                    <tr><td>Bonus</td><td class="numeric">@pc.Bonus.ToString("N2")</td><td>@(pc.LoanRepayment > 0 ? "Loan repayment" : "")</td><td class="numeric">@(pc.LoanRepayment > 0 ? pc.LoanRepayment.ToString("N2") : "")</td></tr>
                    @if (pc.LeaveAllowance > 0) { <tr><td>Leave allowance</td><td class="numeric">@pc.LeaveAllowance.ToString("N2")</td><td></td><td></td></tr> }
                    @if (pc.EndOfService > 0) { <tr><td>End-of-service benefit</td><td class="numeric">@pc.EndOfService.ToString("N2")</td><td></td><td></td></tr> }
                </tbody>
                <tfoot><tr><th>Gross pay</th><td class="numeric">@pc.Gross.ToString("N2")</td><th>Total deductions</th><td class="numeric">@((pc.Paye + pc.NassitEmployee + pc.OtherDeductions + pc.LoanRepayment).ToString("N2"))</td></tr>
                    <tr><th colspan="3">Net pay</th><td class="numeric"><strong>@printSetup.Company.Money(pc.Net)</strong></td></tr></tfoot></table>
            @if (pc.Statutory) { <p class="hint">Tax-free allowances @pc.TaxFreeAllowances.ToString("N2") · chargeable income @pc.Chargeable.ToString("N2") · employer NASSIT @pc.NassitEmployer.ToString("N2")</p> }
            <p>@(ps.Reversed ? "REVERSED — not a current payroll entitlement" : ps.Paid ? $"Paid on {ps.PaidOn:dd MMM yyyy} ({ps.PaymentNumber})." : "Posted payroll entitlement; not yet paid.")</p>
            <DocumentFooter Setup="printSetup" Kind="other" Total="pc.Net" />
        </section>
    }
}
else if (tab == "Loans")
{
    <section class="panel"><h2>Staff loans and salary advances</h2>
        <p class="hint">A loan is paid out now and recovered from salary each month by the instalment, until repaid. Skip an instalment in a payroll run when agreed.</p>
        <div class="table-wrap"><table><thead><tr><th>Loan</th><th>Employee</th><th>Date</th><th class="numeric">Amount</th><th class="numeric">Monthly</th><th class="numeric">Repaid</th><th class="numeric">Outstanding</th><th>Reason</th></tr></thead>
            <tbody>@foreach (var l in loans) { <tr><td>@l.Number@(l.Reversed ? " (reversed)" : "")</td><td>@l.Employee</td><td>@l.Date.ToString("dd MMM yyyy")</td><td class="numeric">@l.Principal.ToString("N2")</td><td class="numeric">@l.Installment.ToString("N2")</td><td class="numeric">@l.Repaid.ToString("N2")</td><td class="numeric"><strong>@l.Outstanding.ToString("N2")</strong></td><td>@l.Reason</td></tr> }</tbody></table></div>
        @if (loans.Count == 0) { <p class="hint">No loans recorded.</p> }
    </section>
    <section class="panel"><h2>Give a loan or advance</h2>
        <div class="form-grid">
            <label>Employee<select @bind="loanEmployee"><option value="@Guid.Empty">Choose…</option>@foreach (var e in data.Employees.Where(x => x.EndDate is null || x.EndDate >= Today)) { <option value="@e.Id">@e.Code · @e.Name</option> }</select></label>
            <label>Amount (NLe)<input type="number" min="0.01" step="0.01" @bind="loanPrincipal" /></label><label>Monthly instalment<input type="number" min="0.01" step="0.01" @bind="loanInstallment" /></label>
            <label>Date<input type="date" @bind="loanDate" /></label><label>Paid by<select @bind="loanMethod"><option value="@PaymentMethod.Cash">Cash</option><option value="@PaymentMethod.BankTransfer">Bank transfer</option></select></label>
            <label>Reference<input maxlength="100" @bind="loanReference" /></label><label>Reason<input maxlength="160" @bind="loanReason" /></label>
        </div>
        <button class="primary" disabled="@(busy || loanEmployee == Guid.Empty)" @onclick="GiveLoan">Record loan</button>
    </section>
}
else if (tab == "PAYE & NASSIT")
{
    <section class="panel"><div class="panel-title"><h2>Statutory rules</h2>@if (rules is { } r) { <span class="status-badge a-Approved">Version @r.Version · from @r.EffectiveFrom.ToString("MMMM yyyy")</span> } else { <span class="status-badge a-Rejected">Off</span> }</div>
        <p class="hint">Rates and bands are dated settings. A change applies from the month you choose; payslips already posted keep the rules they were calculated with. Check the figures with the NRA and NASSIT before you rely on them.</p>
        <div class="form-grid"><label>Applies from payroll month<input type="month" @bind="RulesFromText" /></label><label>Source (Finance Act, NRA or NASSIT notice)<input maxlength="300" @bind="source" /></label></div>
        <h3>PAYE bands (monthly chargeable income)</h3>
        <div class="table-wrap"><table><thead><tr><th>Income up to (NLe)</th><th>Rate %</th><th></th></tr></thead><tbody>
            @for (var i = 0; i < bands.Count; i++) { var index = i; var last = i == bands.Count - 1;
                <tr><td>@if (last) { <span>Above the previous band</span> } else { <input class="num" type="number" min="0" step="0.01" value="@bands[index].UpTo" @onchange="v => SetBand(index, v, null)" /> }</td>
                    <td><input class="num" type="number" min="0" max="100" step="0.01" value="@(bands[index].Rate * 100)" @onchange="v => SetBand(index, null, v)" /></td>
                    <td>@if (!last && bands.Count > 1) { <button class="text-button" @onclick="() => bands.RemoveAt(index)">Remove</button> }</td></tr> }
        </tbody></table></div>
        @if (bands.Count < 10) { <button class="secondary" @onclick="AddBand">Add band</button> }
        <div class="form-grid">
            <label>Tax-free allowances per month (NLe)<input type="number" min="0" step="0.01" @bind="taxFree" /></label>
            <label>Non-resident rate %<input type="number" min="0" max="100" step="0.01" @bind="nonResident" /></label>
            <label>NASSIT employee %<input type="number" min="0" max="100" step="0.01" @bind="nassitEmployee" /></label>
            <label>NASSIT employer %<input type="number" min="0" max="100" step="0.01" @bind="nassitEmployer" /></label>
            <label>NASSIT calculated on<select @bind="nassitBase"><option value="@NassitBase.BasicSalary">Basic salary</option><option value="@NassitBase.GrossPay">Gross pay</option></select></label>
            <label>NASSIT stops after age (0 = never)<input type="number" min="0" max="100" @bind="ageLimit" /></label>
            <label class="check"><input type="checkbox" @bind="leaveTaxFree" /> Leave allowance up to one month's basic is tax-free</label>
            <label>Tax rate on leave allowance above that %<input type="number" min="0" max="100" step="0.01" @bind="leaveExcessRate" /></label>
            <label class="check"><input type="checkbox" @bind="eosTaxFree" /> End-of-service benefits are tax-free</label>
        </div>
        <button class="primary" disabled="@busy" @onclick="SaveRules">Save rules</button> <button class="secondary" disabled="@busy" @onclick="UseRecommended">Fill in current Sierra Leone rates</button>
        @if (history.Count > 0) { <details><summary>@history.Count saved version@(history.Count == 1 ? "" : "s")</summary><ul>@foreach (var h in history) { <li>Version @h.Version from @h.EffectiveFrom.ToString("MMMM yyyy") — @h.Source (@h.SavedBy, @h.Saved?.ToLocalTime().ToString("dd MMM yyyy"))</li> }</ul></details> }
    </section>
    <section class="panel"><div class="panel-title"><h2>Monthly schedules and remittances</h2>@if (schedule is not null) { <button class="secondary" disabled="@busy" @onclick="Export">Export to Excel</button> }</div>
        <div class="report-period"><label>Month<input type="month" @bind="ScheduleMonthText" @bind:after="LoadSchedule" /></label></div>
        @if (schedule is { } s)
        {
            @if (s.Lines.Count == 0) { <p class="hint">No payroll is posted for @s.Month.ToString("MMMM yyyy").</p> }
            else
            {
                <div class="table-wrap"><table class="report-table"><thead><tr><th>Employee</th><th>TIN</th><th>NASSIT no.</th><th class="numeric">Gross</th><th class="numeric">Chargeable</th><th class="numeric">PAYE</th><th class="numeric">NASSIT employee</th><th class="numeric">NASSIT employer</th></tr></thead>
                    <tbody>@foreach (var l in s.Lines) { <tr><td>@l.Code · @l.Name</td><td>@l.Tin</td><td>@l.NassitNumber</td><td class="numeric">@l.Gross.ToString("N2")</td><td class="numeric">@l.Chargeable.ToString("N2")</td><td class="numeric">@l.Paye.ToString("N2")</td><td class="numeric">@l.NassitEmployee.ToString("N2")</td><td class="numeric">@l.NassitEmployer.ToString("N2")</td></tr> }</tbody>
                    <tfoot><tr><th colspan="5">Total</th><td class="numeric">@s.Paye.ToString("N2")</td><td class="numeric">@s.NassitEmployee.ToString("N2")</td><td class="numeric">@s.NassitEmployer.ToString("N2")</td></tr></tfoot></table></div>
                <p>PAYE outstanding: <strong>NLe @s.PayeOutstanding.ToString("N2")</strong> · NASSIT outstanding: <strong>NLe @s.NassitOutstanding.ToString("N2")</strong></p>
                @foreach (var rem in s.Remittances) { <p class="hint">@(rem.Kind == StatutoryKind.Paye ? "PAYE" : "NASSIT") remitted @rem.Date.ToString("dd MMM yyyy") · NLe @rem.Amount.ToString("N2") · @rem.Reference (@rem.Number)</p> }
                @if (s.PayeOutstanding > 0 || s.NassitOutstanding > 0)
                {
                    <h3>Record a remittance</h3>
                    <div class="form-grid"><label>Pay<select @bind="remitKind"><option value="@StatutoryKind.Paye">PAYE to the NRA</option><option value="@StatutoryKind.Nassit">NASSIT contributions</option></select></label><label>Date<input type="date" @bind="remitDate" /></label><label>Paid by<select @bind="remitMethod"><option value="@PaymentMethod.BankTransfer">Bank transfer</option><option value="@PaymentMethod.Cash">Cash</option></select></label><label>Receipt or transfer reference<input maxlength="100" @bind="remitReference" /></label></div>
                    <button class="primary" disabled="@busy" @onclick="RemitNow">Record remittance of NLe @((remitKind == StatutoryKind.Paye ? s.PayeOutstanding : s.NassitOutstanding).ToString("N2"))</button>
                }
            }
        }
    </section>
}

@code {
    [Parameter] public string CompanyName { get; set; } = "";
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Now);
    private PayrollSnapshot data = new([], []);
    private bool busy;
    private string tab = "Employees", error = "", message = "";
    private PrintSetup printSetup = PrintSetups.Default;
    private PayrollRules? rules; private List<PayrollRules> history = [];

    // employees
    private string code = "", name = "", department = "", tin = "", nassitNumber = "", bankName = "", bankAccount = "";
    private Guid? employeeId; private int version; private decimal basic, allowances, deductions; private bool resident = true, nassitExempt;
    private DateOnly start = DateOnly.FromDateTime(DateTime.Now); private DateOnly? end, birthDate;
    private Guid employeeOperation = Guid.NewGuid();
    public bool HasDraft => code.Length > 0 || name.Length > 0 || department.Length > 0 || selected.Count > 0;

    // run
    private DateOnly month = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1), postingDate = DateOnly.FromDateTime(DateTime.Now);
    private DateTime MonthText { get => month.ToDateTime(TimeOnly.MinValue); set { month = new DateOnly(value.Year, value.Month, 1); preview = null; } }
    private readonly HashSet<Guid> selected = [];
    private readonly Dictionary<Guid, PayrollAdjustment> adjustments = [];
    private PayrollPreview? preview; private Guid payrollOperation = Guid.NewGuid();
    private IEnumerable<EmployeeView> Eligible => data.Employees.Where(e => e.StartDate <= month.AddMonths(1).AddDays(-1) && (e.EndDate is null || e.EndDate >= month));
    private PayrollAdjustment Adjustment(Guid id) => adjustments.TryGetValue(id, out var a) ? a : new(id);
    private void Adjust(Guid id, Func<PayrollAdjustment, PayrollAdjustment> change) { adjustments[id] = change(Adjustment(id)); preview = null; }
    private static decimal Num(ChangeEventArgs v) => decimal.TryParse(v.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0;
    private PayrollCommand Command() => new(payrollOperation, month, postingDate, selected.ToList(), adjustments.Values.Where(a => selected.Contains(a.EmployeeId) && a != new PayrollAdjustment(a.EmployeeId)).ToList());

    // payslips and payments
    private string slipMonth = "";
    private IEnumerable<DateOnly> Months => data.Payslips.Select(x => x.Month).Distinct().OrderByDescending(x => x);
    private IEnumerable<PayslipView> MonthSlips => data.Payslips.Where(x => x.Month.ToString("yyyy-MM") == slipMonth);
    private IEnumerable<PayslipView> Unpaid => MonthSlips.Where(x => !x.Reversed && !x.Paid && x.Net > 0);
    private readonly HashSet<Guid> toPay = [];
    private PayslipView? payslip;
    private DateOnly payDate = DateOnly.FromDateTime(DateTime.Now); private PaymentMethod payMethod = PaymentMethod.BankTransfer; private string payReference = ""; private Guid payOperation = Guid.NewGuid();

    // statutory
    private DateOnly rulesFrom = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1);
    private DateTime RulesFromText { get => rulesFrom.ToDateTime(TimeOnly.MinValue); set => rulesFrom = new DateOnly(value.Year, value.Month, 1); }
    private List<PayeBand> bands = [new(null, 0)];
    private decimal taxFree, nonResident, nassitEmployee, nassitEmployer, leaveExcessRate = 30; private bool leaveTaxFree = true, eosTaxFree = true; private int ageLimit; private NassitBase nassitBase; private string source = "";
    private Guid rulesOperation = Guid.NewGuid();
    private DateOnly scheduleMonth = new DateOnly(DateTime.Now.Year, DateTime.Now.Month, 1).AddMonths(-1);
    private DateTime ScheduleMonthText { get => scheduleMonth.ToDateTime(TimeOnly.MinValue); set => scheduleMonth = new DateOnly(value.Year, value.Month, 1); }
    private StatutorySchedule? schedule;
    private StatutoryKind remitKind; private DateOnly remitDate = DateOnly.FromDateTime(DateTime.Now); private PaymentMethod remitMethod = PaymentMethod.BankTransfer; private string remitReference = ""; private Guid remitOperation = Guid.NewGuid();

    // loans
    private IReadOnlyList<LoanView> loans = []; private Guid loanEmployee; private decimal loanPrincipal, loanInstallment; private DateOnly loanDate = DateOnly.FromDateTime(DateTime.Now);
    private PaymentMethod loanMethod = PaymentMethod.Cash; private string loanReference = "", loanReason = ""; private Guid loanOperation = Guid.NewGuid();
    private Task GiveLoan() => Run(async () =>
    {
        await Payroll.GiveLoan(new(loanOperation, loanEmployee, loanPrincipal, loanInstallment, loanDate, loanMethod, loanReference, loanReason));
        loanOperation = Guid.NewGuid(); loanEmployee = Guid.Empty; loanPrincipal = loanInstallment = 0; loanReference = loanReason = ""; await Load(); message = "Loan recorded and paid out.";
    });
    private Task DownloadBankFile() => Run(async () =>
    {
        var bytes = await Payroll.BankFile(toPay.ToList());
        await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(JS, "sierraDownload", $"salaries-{slipMonth}.csv", Convert.ToBase64String(bytes));
    });

    protected override async Task OnInitializedAsync() { printSetup = await PrintSetups.Load(Services); await Run(Load); }
    private async Task Load()
    {
        data = await Payroll.Read();
        loans = await Payroll.Loans();
        var view = await Payroll.Rules(); rules = view.Current; history = view.History.ToList();
        if (slipMonth.Length == 0 || !Months.Any(m => m.ToString("yyyy-MM") == slipMonth)) slipMonth = Months.FirstOrDefault().ToString("yyyy-MM");
        ApplyRules(view.History.FirstOrDefault());
    }
    private Task Open(string t) { tab = t; error = message = ""; return t == "PAYE & NASSIT" ? Run(async () => { await Load(); await LoadScheduleCore(); }) : Run(Load); }
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } catch (Exception) { error = "Payroll could not complete. Check the details and try again."; } finally { busy = false; } }

    private void Choose(Guid id, ChangeEventArgs args) { if (args.Value is true) selected.Add(id); else selected.Remove(id); preview = null; }
    private void ChooseAll(ChangeEventArgs args) { selected.Clear(); if (args.Value is true) foreach (var e in Eligible) selected.Add(e.Id); preview = null; }
    private async Task Edit(EmployeeView e)
    {
        if (code.Length > 0 && !await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<bool>(JS, "confirm", "Discard unsaved employee changes?")) return;
        employeeId = e.Id; version = e.Version; code = e.Code; name = e.Name; department = e.Department; basic = e.BasicSalary; allowances = e.Allowances; deductions = e.Deductions; start = e.StartDate; end = e.EndDate;
        tin = e.Tin; nassitNumber = e.NassitNumber; resident = e.Resident; nassitExempt = e.NassitExempt; birthDate = e.BirthDate; bankName = e.BankName; bankAccount = e.BankAccount; employeeOperation = Guid.NewGuid();
    }
    private void Clear() { employeeId = null; version = 0; code = name = department = tin = nassitNumber = bankName = bankAccount = ""; basic = allowances = deductions = 0; end = birthDate = null; resident = true; nassitExempt = false; employeeOperation = Guid.NewGuid(); }
    private async Task New() { if (code.Length == 0 || await Microsoft.JSInterop.JSRuntimeExtensions.InvokeAsync<bool>(JS, "confirm", "Discard unsaved employee changes?")) Clear(); }
    private Task Save() => Run(async () => { await Payroll.SaveEmployee(new(employeeOperation, employeeId, version, code, name, department, basic, allowances, deductions, start, end, tin, nassitNumber, resident, nassitExempt, birthDate, bankName, bankAccount)); Clear(); data = await Payroll.Read(); message = "Employee saved. Earlier payslips are unchanged."; });

    private Task PreviewRun() => Run(async () => preview = await Payroll.Preview(Command()));
    private Task Post() => Run(async () =>
    {
        await Payroll.Post(Command());
        payrollOperation = Guid.NewGuid(); selected.Clear(); adjustments.Clear(); preview = null; await Load();
        slipMonth = month.ToString("yyyy-MM"); message = $"Payroll for {month:MMMM yyyy} posted. Pay salaries from Payslips & payments.";
    });

    private void ChoosePay(Guid id, ChangeEventArgs args) { if (args.Value is true) toPay.Add(id); else toPay.Remove(id); }
    private void ChooseAllUnpaid(ChangeEventArgs args) { toPay.Clear(); if (args.Value is true) foreach (var s in Unpaid) toPay.Add(s.ItemId); }
    private Task PaySelected() => Run(async () =>
    {
        await Payroll.PaySalaries(new(payOperation, payDate, payMethod, payReference, toPay.ToList()));
        message = $"{toPay.Count} salar{(toPay.Count == 1 ? "y" : "ies")} paid."; toPay.Clear(); payOperation = Guid.NewGuid(); payReference = ""; await Load();
    });

    private void ApplyRules(PayrollRules? r)
    {
        if (r is null) return;
        bands = r.PayeBands.ToList(); taxFree = r.TaxFreeAllowances; nonResident = r.NonResidentRate * 100; nassitEmployee = r.NassitEmployee * 100; nassitEmployer = r.NassitEmployer * 100;
        nassitBase = r.NassitBase; ageLimit = r.NassitAgeLimit; source = r.Source; leaveTaxFree = r.LeaveUpToBasicTaxFree; leaveExcessRate = r.LeaveExcessRate * 100; eosTaxFree = r.EndOfServiceTaxFree;
    }
    private void UseRecommended() { ApplyRules(PayrollRules.Recommended(rulesFrom)); message = "Current Sierra Leone rates filled in. Check them, then save."; }
    private void AddBand() => bands.Insert(bands.Count - 1, new(bands.Count > 1 ? (bands[^2].UpTo ?? 0) + 600 : 600, bands[^1].Rate));
    private void SetBand(int i, ChangeEventArgs? upTo, ChangeEventArgs? rate)
    {
        if (upTo is not null) bands[i] = bands[i] with { UpTo = Num(upTo) };
        if (rate is not null) bands[i] = bands[i] with { Rate = Math.Round(Num(rate) / 100, 4) };
    }
    private Task SaveRules() => Run(async () =>
    {
        await Payroll.SaveRules(new(rulesOperation, new PayrollRules(history.FirstOrDefault()?.Version ?? 0, rulesFrom, bands.ToList(), taxFree, Math.Round(nonResident / 100, 4), Math.Round(nassitEmployee / 100, 4), Math.Round(nassitEmployer / 100, 4), nassitBase, ageLimit, source, LeaveUpToBasicTaxFree: leaveTaxFree, LeaveExcessRate: Math.Round(leaveExcessRate / 100, 4), EndOfServiceTaxFree: eosTaxFree)));
        rulesOperation = Guid.NewGuid(); await Load(); message = $"Payroll rules saved from {rulesFrom:MMMM yyyy}.";
    });
    private async Task LoadScheduleCore() => schedule = await Payroll.Schedule(scheduleMonth);
    private Task LoadSchedule() => Run(LoadScheduleCore);
    private Task RemitNow() => Run(async () =>
    {
        await Payroll.Remit(new(remitOperation, scheduleMonth, remitKind, remitDate, remitMethod, remitReference));
        remitOperation = Guid.NewGuid(); remitReference = ""; await LoadScheduleCore(); message = "Remittance recorded.";
    });
    private Task Export() => Run(async () =>
    {
        var bytes = await Payroll.ExportSchedule(scheduleMonth);
        await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(JS, "sierraDownload", $"PAYE-NASSIT-{scheduleMonth:yyyy-MM}.xlsx", Convert.ToBase64String(bytes));
    });
}
