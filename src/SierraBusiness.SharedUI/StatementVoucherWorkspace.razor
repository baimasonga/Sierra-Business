@inject IBankingService Banking
@inject IFinanceService Finance
<section class="panel" aria-label="Vouchers from bank statements">
    <h2>Create voucher from reviewed bank row</h2>
    <p class="hint">Use matching for entries already recorded. For an unrecorded fee, expense or receipt, review the bank row and counter account here. Posting creates the balanced voucher and its statement match together.</p>
    @if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
    @if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
    <fieldset disabled="@busy"><div class="form-grid">
        <label>Unmatched statement row<select @bind="rowId" @bind:after="Clear"><option value="@Guid.Empty">Choose a reviewed row</option>@foreach (var r in banking?.Rows.Where(r => r.MatchId is null) ?? []) { <option value="@r.Id">@r.Date · @r.Reference · @r.Amount.ToString("N2") NLe</option> }</select></label>
        <label>Counter account<select @bind="counter" @bind:after="Clear"><option value="0">Choose the expense or receipt account</option>@foreach (var a in finance?.Accounts.Where(a => !a.CashOrBank && !a.Control) ?? []) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label>
        <label>Voucher narration<input maxlength="200" @bind="narration" @bind:after="Clear" /></label>
    </div><button class="secondary" @onclick="Review">Review statement voucher</button>
    @if (reviewed is { } q) { <p>@q.Type on @q.Date: @q.Narration. Bank @q.Lines[0].AccountCode and counter account @q.Lines[1].AccountCode, @q.Lines.Sum(l => l.Debit).ToString("N2") NLe.</p><button class="primary" @onclick="Post">Post voucher and match</button> }
    </fieldset>
</section>
@code {
    private BankingSnapshot? banking; private FinanceSnapshot? finance; private Guid rowId; private int counter; private string narration = "", error = "", message = ""; private bool busy; private VoucherCommand? reviewed;
    public bool HasDraft => rowId != Guid.Empty || counter != 0 || narration.Length > 0;
    protected override Task OnInitializedAsync() => Run(Load);
    private async Task Load() { banking = await Banking.Read(); finance = await Finance.Read(DateOnly.MinValue, DateOnly.FromDateTime(DateTime.UtcNow)); }
    private void Clear() { reviewed = null; message = ""; }
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } finally { busy = false; } }
    private Task Review() => Run(async () => {
        reviewed = null; await Load(); var row = banking!.Rows.SingleOrDefault(r => r.Id == rowId && r.MatchId is null) ?? throw new BusinessException("Choose an active unmatched statement row.");
        if (!finance!.Accounts.Any(a => a.Code == counter && !a.CashOrBank && !a.Control)) throw new BusinessException("Choose a non-control expense, income, asset, liability or equity account.");
        var bank = banking.Statements.Single(s => s.Id == row.StatementId).AccountCode; var amount = Math.Abs(row.Amount);
        reviewed = new(Guid.NewGuid(), row.Amount > 0 ? VoucherType.Receipt : VoucherType.Payment, row.Date, Rules.Required(narration, "Voucher narration", 200), [new(bank, row.Amount > 0 ? amount : 0, row.Amount < 0 ? amount : 0), new(counter, row.Amount < 0 ? amount : 0, row.Amount > 0 ? amount : 0)], [], StatementRowId: row.Id);
    });
    private Task Post() => Run(async () => { if (reviewed is null) throw new BusinessException("Review the statement voucher first."); await Finance.PostVoucher(reviewed); reviewed = null; rowId = Guid.Empty; narration = ""; await Load(); message = "Statement voucher and bank match posted together."; });
}
