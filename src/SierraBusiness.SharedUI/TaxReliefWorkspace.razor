@inject IComplianceService Compliance
@inject IPartyService Parties
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
<section class="panel"><h2>Recipient-specific GST relief</h2><p>Record the reviewed authority certificate and this branch's approved allocation. Relief does not exempt a product for every buyer. A selected invoice uses only this recipient's remaining allowance; returns and cancellations restore the recorded net usage.</p>
@if (Actor.Permissions.Contains("accounting.write")) { <div class="form-grid"><label>Relief recipient<select @bind="customer"><option value="@Guid.Empty">Choose registered customer</option>@foreach (var p in parties.Where(p => p.Type != PartyType.Supplier)) { <option value="@p.Id">@p.Name</option> }</select></label><label>Authority certificate reference<input maxlength="80" @bind="reference" /></label><label>Certificate valid from<input type="date" @bind="from" /></label><label>Certificate valid through<input type="date" @bind="through" /></label><label>Branch-approved net ceiling NLe<input type="number" min="0.01" step="0.01" @bind="limit" /></label><label>Certificate and branch-allocation review reason<input maxlength="200" @bind="reason" /></label></div><button class="primary" disabled="@busy" @onclick="Save">Record reviewed relief authority</button> }
<button class="secondary" disabled="@busy" @onclick="Refresh">Refresh relief usage</button><div class="table-wrap"><table><thead><tr><th>Recipient</th><th>Certificate</th><th>Valid dates</th><th>Approved net</th><th>Used net</th><th>Remaining net</th></tr></thead><tbody>@foreach (var g in grants) { <tr><td>@g.Customer</td><td>@g.AuthorityReference</td><td>@g.From — @g.Through</td><td>@g.BranchNetLimit.ToString("N2")</td><td>@g.UsedNet.ToString("N2")</td><td>@g.Remaining.ToString("N2")</td></tr> }</tbody></table></div></section>
@code {
    [Parameter] public Actor Actor { get; set; } = default!; private bool busy; private string error = "",message = "",reference = "",reason = ""; private Guid customer,operation = Guid.NewGuid(); private decimal limit; private DateOnly from = DateOnly.FromDateTime(DateTime.UtcNow),through = DateOnly.FromDateTime(DateTime.UtcNow).AddYears(1); private IReadOnlyList<PartyView> parties = []; private IReadOnlyList<TaxReliefGrantView> grants = [];
    public bool HasDraft => customer != Guid.Empty || reference.Length > 0 || reason.Length > 0 || limit != 0;
    protected override Task OnInitializedAsync() => Refresh(); private Task Refresh() => Run(async () => { parties = await Parties.Read(); grants = await Compliance.ReliefGrants(); });
    private Task Save() => Run(async () => { await Compliance.RecordReliefGrant(new(operation,customer,reference,from,through,limit,reason)); operation = Guid.NewGuid(); customer = Guid.Empty; reference = reason = ""; limit = 0; grants = await Compliance.ReliefGrants(); message = "Reviewed relief authority recorded. Select it on the eligible recipient's invoice."; });
    private async Task Run(Func<Task> work) { if (busy) return; busy = true; error = message = ""; try { await work(); } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException) { error = e.Message; } catch { error = "The relief record could not complete. Refresh recorded authorities before retrying."; } finally { busy = false; } }
}
