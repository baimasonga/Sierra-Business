@inject IOperationsService Operations
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
@if (view is { } v)
{
    <section class="panel">
        <div class="panel-title"><h2>System health</h2><span class="status-badge @(v.Health == "Healthy" ? "a-Approved" : v.Health == "Degraded" ? "a-Pending" : "a-Rejected")">@v.Health</span></div>
        <div class="metrics">
            <section><small>VERSION</small><strong>@v.Version</strong><span>@v.Runtime</span></section>
            <section><small>DATABASE</small><strong>@(v.DatabaseBytes > 0 ? $"{v.DatabaseBytes / 1048576.0:0.0} MB" : "—")</strong><span>@v.Database</span></section>
            <section><small>SCHEMA</small><strong>@(v.PendingMigrations == 0 ? "Up to date" : $"{v.PendingMigrations} upgrade(s) pending")</strong><span>@v.SchemaVersion</span></section>
            <section><small>BRANCH / DEVICE</small><strong>@v.Branch</strong><span>@v.Device</span></section>
        </div>
        <p><strong>Backups:</strong> @v.Backup<br /><strong>Integrity:</strong> @v.Integrity<br /><strong>Computer:</strong> @v.OperatingSystem · checked @v.ServerTime.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p>
        <p class="hint">@string.Join(" · ", v.Counts.Select(c => $"{c.Key}: {c.Value:N0}"))</p>
    </section>
    <section class="panel"><div class="panel-title"><h2>Background tasks</h2><button class="secondary" disabled="@busy" @onclick="Load">Refresh</button></div>
        <div class="table-wrap"><table><thead><tr><th>Task</th><th>Every</th><th>Last run</th><th>Last success</th><th>Next</th><th>Status</th><th></th></tr></thead>
            <tbody>@foreach (var j in v.Jobs) { <tr><td>@j.Description</td><td>@Every(j.Interval)</td><td>@When(j.LastRun)</td><td>@When(j.LastSuccess)</td><td>@When(j.NextDue)</td>
                <td>@(j.DeadLettered ? "Stopped — needs attention" : j.ConsecutiveFailures > 0 ? $"Retrying (failed {j.ConsecutiveFailures}×)" : j.LastRun is null ? "Waiting" : "OK")<br /><small class="hint">@j.LastMessage</small></td>
                <td><button class="text-button" disabled="@busy" @onclick="() => RunNow(j.Job)">Run now</button></td></tr> }</tbody></table></div>
        <details><summary>Recent runs (@v.Runs.Count)</summary>
            <div class="table-wrap"><table><thead><tr><th>Started</th><th>Task</th><th>Attempt</th><th>Outcome</th><th>Message</th></tr></thead>
                <tbody>@foreach (var r in v.Runs) { <tr><td>@r.Started.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td>@r.Job</td><td>@r.Attempt</td><td>@r.Outcome</td><td>@r.Message</td></tr> }</tbody></table></div>
        </details>
        <p class="hint">Failed tasks are retried after 1, 2, 4… minutes (at most an hour). After 8 failures in a row, or a failure retrying cannot fix, a task stops and administrators get a reminder; Run now restarts it. No passwords or keys are shown here.</p>
    </section>
}
@code {
    private DiagnosticsView? view; private bool busy; private string error = "", message = "";
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() { busy = true; error = ""; try { view = await Operations.Diagnostics(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } finally { busy = false; } }
    private async Task RunNow(string job)
    {
        busy = true; error = message = "";
        try { var r = await Operations.RunNow(job); if (r.Outcome == JobOutcome.Succeeded) message = $"{job}: {r.Message}"; else error = $"{job}: {r.Message}"; }
        catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; }
        finally { busy = false; }
        await Load();
    }
    private static string When(DateTimeOffset? t) => t?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—";
    private static string Every(TimeSpan t) => t.TotalHours >= 1 ? $"{t.TotalHours:0} h" : $"{t.TotalMinutes:0} min";
}
