@inject IFinanceService Finance
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
@if (saved is null || structure is null || accounts is null) { <p>Loading projects and schedules…</p> }
else
{
    @if (CanWrite)
    {
        <section class="panel"><h2>Reusable allocation classes</h2><p>Save percentages once, then review each payment or receipt before posting.</p>
        <label>New allocation class name<input maxlength="100" @bind="className" /></label>
        <div class="table-wrap"><table><thead><tr><th>Cost centre</th><th>Percent</th></tr></thead><tbody>@foreach (var c in structure.Centres.Where(c => c.Active)) { <tr><td>@c.Code · @c.Name</td><td><input type="number" min="0" max="100" step="0.01" aria-label="Class share for @c.Code" value="@shares.GetValueOrDefault(c.Id)" @onchange="e => SetShare(c.Id, e)" /></td></tr> }</tbody></table></div>
        <button class="primary" disabled="@busy" @onclick="SaveClass">Save allocation class</button>
        <h3>Parallel cost categories</h3><p>Each category is a separate view of the same revenue and expenses. Never add category totals together. The percentages above can also classify an existing document without changing its journal.</p>
        <label>New category name<input maxlength="100" @bind="categoryName" /></label><button class="secondary" disabled="@busy" @onclick="SaveCategory">Save cost category</button>
        <div class="form-grid"><label>Cost category<select @bind="categoryId">@foreach (var c in categories.Where(c => c.Active)) { <option value="@c.Id">@c.Name</option> }</select></label><label>Document to classify<select @bind="categoryDocument">@foreach (var d in accounts.Entries.Where(e => !e.Reversed).DistinctBy(e => e.DocumentId)) { <option value="@d.DocumentId">@d.Date · @d.Number · @d.Party</option> }</select></label></div><button class="secondary" disabled="@busy" @onclick="AllocateCategory">Record category allocation</button>
        <div class="form-grid"><label>Saved class<select @bind="selectedClass" @bind:after="Invalidate">@foreach (var c in saved.Classes.Where(c => c.Active)) { <option value="@c.Id">@c.Name</option> }</select></label>
        <label>Type<select @bind="income" @bind:after="ChooseAccount"><option value="false">Expense payment</option><option value="true">Income receipt</option></select></label>
        <label>Income or expense account<select @bind="account" @bind:after="Invalidate">@foreach (var a in accounts.Accounts.Where(a => !a.Control && a.Group == (income ? LedgerGroup.Income : LedgerGroup.Expense))) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label>
        <label>Cash or bank<select @bind="funds" @bind:after="Invalidate">@foreach (var a in accounts.Accounts.Where(a => a.CashOrBank)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label>
        <label>Date<input type="date" @bind="date" @bind:after="Invalidate" /></label><label>Amount<input type="number" min="0.01" step="0.01" @bind="amount" @bind:after="Invalidate" /></label><label>Narration<input maxlength="200" @bind="narration" @bind:after="Invalidate" /></label></div>
        <button class="secondary" disabled="@(busy || selectedClass == Guid.Empty)" @onclick="ReviewClass">Review class allocation</button>
        @if (preview is not null) { <table><thead><tr><th>Ledger</th><th>Centre</th><th>Debit</th><th>Credit</th></tr></thead><tbody>@foreach (var l in preview.Lines) { <tr><td>@l.AccountCode</td><td>@l.CostCentre</td><td>@l.Debit.ToString("N2")</td><td>@l.Credit.ToString("N2")</td></tr> }</tbody></table><button class="primary" disabled="@busy" @onclick="PostClass">Post reviewed allocation</button> }
        </section>
        <section class="panel"><h2>Register a commercial project</h2><p>Each project uses its own cost centre. Actual revenue and expenses come from posted centre entries, including cancellations. Budgets cover the whole project; report dates select actual activity.</p><div class="form-grid">
        <label>Project code<input maxlength="40" @bind="projectCode" /></label><label>Project name<input maxlength="100" @bind="projectName" /></label><label>Cost centre<select @bind="projectCentre">@foreach (var c in structure.Centres.Where(c => c.Active)) { <option value="@c.Id">@c.Code · @c.Name</option> }</select></label>
        <label>Project start<input type="date" @bind="projectStart" /></label><label>Revenue budget<input type="number" min="0" step="0.01" @bind="revenueBudget" /></label><label>Expense budget<input type="number" min="0" step="0.01" @bind="expenseBudget" /></label></div><button class="primary" disabled="@busy" @onclick="SaveProject">Register project</button>
        <h3>Assign trading or expense documents</h3><p>A document belongs to one project. Its posted revenue and expenses, including later cancellation, feed project profitability. Inventory purchases remain assets until their cost is recognized through trading. Explicit assignment takes precedence over a legacy centre code.</p><div class="form-grid"><label>Registered project<select @bind="assignedProject">@foreach (var p in saved.Projects.Where(p => p.Active)) { <option value="@p.Id">@p.Code · @p.Name</option> }</select></label><label>Project document<select @bind="projectDocument">@foreach (var d in accounts.Entries.Where(e => !e.Reversed).DistinctBy(e => e.DocumentId)) { <option value="@d.DocumentId">@d.Date · @d.Number · @d.Party</option> }</select></label><label>Assignment reason<input maxlength="200" @bind="assignmentReason" /></label></div><button class="secondary" disabled="@busy" @onclick="AssignProjectDocument">Assign reviewed document to project</button></section>
        <section class="panel"><h2>Schedule a journal</h2><p>Schedules do not post automatically. Review a due journal and its optional reversal separately. Both dates must be open and no later than today when posted.</p><div class="form-grid"><label>Journal name<input maxlength="100" @bind="journalName" /></label><label>Journal date<input type="date" @bind="journalDate" /></label><label class="check"><input type="checkbox" @bind="reverse" />Schedule a reversal</label>@if (reverse) { <label>Reversal date<input type="date" @bind="reverseDate" /></label> }
        <label>Debit ledger<select @bind="debitAccount">@foreach (var a in accounts.Accounts.Where(a => !a.Control)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Credit ledger<select @bind="creditAccount">@foreach (var a in accounts.Accounts.Where(a => !a.Control)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Journal amount<input type="number" min="0.01" step="0.01" @bind="journalAmount" /></label></div><button class="primary" disabled="@busy" @onclick="SaveJournal">Save journal schedule</button></section>
    }
    <section class="panel"><h2>Project profitability</h2><div class="form-grid"><label>From<input type="date" @bind="from" /></label><label>To<input type="date" @bind="to" /></label></div><button class="secondary" disabled="@busy" @onclick="Refresh">Refresh project report</button>
    @if (report is not null) { <div class="table-wrap"><table><thead><tr><th>Project</th><th>Revenue</th><th>Expenses</th><th>Profit</th><th>Revenue vs budget</th><th>Expense budget remaining</th></tr></thead><tbody>@foreach (var p in report.Projects) { <tr><td>@p.Project.Code · @p.Project.Name</td><td>@p.Revenue.ToString("N2")</td><td>@p.Expenses.ToString("N2")</td><td>@p.Profit.ToString("N2")</td><td>@p.RevenueVariance.ToString("N2")</td><td>@p.ExpenseVariance.ToString("N2")</td></tr> }</tbody></table></div> }</section>
    @if (categoryReport is not null) { <section class="panel"><h2>Category analysis</h2><p>Each category includes unallocated activity and independently reconciles to the books.</p><div class="table-wrap"><table><thead><tr><th>Category</th><th>Centre</th><th>Revenue</th><th>Expenses</th><th>Profit</th></tr></thead><tbody>@foreach (var r in categoryReport.Rows) { <tr><td>@r.Category</td><td>@r.Centre</td><td>@r.Revenue.ToString("N2")</td><td>@r.Expenses.ToString("N2")</td><td>@r.Profit.ToString("N2")</td></tr> }</tbody></table></div></section> }
    <section class="panel"><h2>Scheduled journal register</h2>@foreach (var j in saved.Journals) { <details><summary>@j.Name · @j.Date · @(j.PostedDocument is null ? "Awaiting posting" : "Posted")</summary><table><thead><tr><th>Ledger</th><th>Centre</th><th>Debit</th><th>Credit</th></tr></thead><tbody>@foreach (var l in j.Lines) { <tr><td>@l.AccountCode</td><td>@l.CostCentre</td><td>@l.Debit.ToString("N2")</td><td>@l.Credit.ToString("N2")</td></tr> }</tbody></table>
    @if (CanWrite && j.Active && j.PostedDocument is null) { <button class="primary" disabled="@(busy || j.Date > DateOnly.FromDateTime(DateTime.Today))" @onclick="() => PostJournal(j, false)">Post reviewed journal</button> }
    @if (j.ReverseOn is DateOnly due) { <p>Reversal due @due · @(j.ReversalDocument is null ? "Awaiting posting" : "Posted")</p>@if (CanWrite && j.PostedDocument is not null && j.ReversalDocument is null) { <button class="secondary" disabled="@(busy || due > DateOnly.FromDateTime(DateTime.Today))" @onclick="() => PostJournal(j, true)">Post reviewed opposite journal</button> } }</details> }</section>
}
@code {
    [Parameter] public Actor Actor { get; set; } = default!;
    private bool CanWrite => Actor.Permissions.Contains("accounting.write"); private bool busy, income, reverse;
    private string error = "", message = "", className = "", narration = "", projectCode = "", projectName = "", journalName = "";
    private AccountingProductivitySnapshot? saved; private AccountingStructure? structure; private FinanceSnapshot? accounts; private ProjectReport? report; private CentreAllocationPreview? preview; private UseAllocationClassCommand? reviewed;
    private IReadOnlyList<CostCategoryView> categories = []; private CategoryReport? categoryReport; private string categoryName = ""; private Guid categoryId, categoryDocument, categoryOperation = Guid.NewGuid(), categoryAllocationOperation = Guid.NewGuid();
    private Guid assignedProject, projectDocument, assignmentOperation = Guid.NewGuid(); private string assignmentReason = "";
    private Task AssignProjectDocument() => Run(async () => { var p = saved!.Projects.SingleOrDefault(p => p.Id == assignedProject) ?? throw new BusinessException("Choose a project."); await Finance.AssignProjectDocument(new(assignmentOperation,p.Id,p.Version,projectDocument,assignmentReason)); assignmentOperation = Guid.NewGuid(); assignmentReason = ""; await Load(); message = "Project document assigned; journal balances are unchanged."; });
    private readonly Dictionary<Guid, decimal> shares = []; private readonly Dictionary<string, Guid> postingIds = [];
    private Guid selectedClass, projectCentre, classOperation = Guid.NewGuid(), projectOperation = Guid.NewGuid(), journalOperation = Guid.NewGuid(), allocationOperation = Guid.NewGuid();
    private int account, funds = 1000, debitAccount, creditAccount; private decimal amount, revenueBudget, expenseBudget, journalAmount;
    private DateOnly date = DateOnly.FromDateTime(DateTime.Today), projectStart = DateOnly.FromDateTime(DateTime.Today), journalDate = DateOnly.FromDateTime(DateTime.Today), reverseDate = DateOnly.FromDateTime(DateTime.Today).AddDays(1), from = new(DateTime.Today.Year, 1, 1), to = DateOnly.FromDateTime(DateTime.Today);
    public bool HasDraft => assignmentReason.Length > 0 || categoryName.Length > 0 || className.Length > 0 || shares.Any(s => s.Value != 0) || narration.Length > 0 || amount != 0 || projectCode.Length > 0 || projectName.Length > 0 || journalName.Length > 0 || journalAmount != 0;
    protected override Task OnInitializedAsync() => Run(async () => { await Load(); ChooseAccount(); debitAccount = accounts!.Accounts.FirstOrDefault(a => !a.Control)?.Code ?? 0; creditAccount = accounts.Accounts.LastOrDefault(a => !a.Control)?.Code ?? 0; });
    private async Task Load() { saved = await Finance.Productivity(); structure = await Finance.Structure(); accounts = await Finance.Read(from, to); report = await Finance.ProjectProfitability(from, to); categories = await Finance.CostCategories(); categoryReport = await Finance.CategoryAnalysis(from, to); if (categoryId == Guid.Empty) categoryId = categories.FirstOrDefault(c => c.Active)?.Id ?? Guid.Empty; if (selectedClass == Guid.Empty) selectedClass = saved.Classes.FirstOrDefault(c => c.Active)?.Id ?? Guid.Empty; if (projectCentre == Guid.Empty) projectCentre = structure.Centres.FirstOrDefault(c => c.Active)?.Id ?? Guid.Empty; }
    private Task SaveCategory() => Run(async () => { await Finance.SaveCostCategory(new(categoryOperation, null, 0, categoryName, true)); categoryOperation = Guid.NewGuid(); categoryName = ""; await Load(); message = "Cost category saved."; });
    private Task AllocateCategory() => Run(async () => { var c = categories.SingleOrDefault(c => c.Id == categoryId) ?? throw new BusinessException("Choose a category."); await Finance.AllocateCategory(new(categoryAllocationOperation, c.Id, c.Version, categoryDocument, shares.Where(s => s.Value != 0).Select(s => new CentreShare(s.Key, s.Value)).ToList())); categoryAllocationOperation = Guid.NewGuid(); shares.Clear(); await Load(); message = "Category allocation recorded; journal balances are unchanged."; });
    private Task Refresh() => Run(Load);
    private async Task Run(Func<Task> work) { if (busy) return; busy = true; error = message = ""; try { await work(); } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException) { error = e.Message; } catch { error = "The operation could not complete. Refresh saved records before retrying."; } finally { busy = false; } }
    private void Invalidate() { preview = null; reviewed = null; }
    private void ChooseAccount() { account = accounts?.Accounts.FirstOrDefault(a => !a.Control && a.Group == (income ? LedgerGroup.Income : LedgerGroup.Expense))?.Code ?? 0; Invalidate(); }
    private void SetShare(Guid id, ChangeEventArgs e) { shares[id] = decimal.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0; }
    private Task SaveClass() => Run(async () => { await Finance.SaveAllocationClass(new(classOperation, null, 0, className, shares.Where(s => s.Value != 0).Select(s => new CentreShare(s.Key, s.Value)).ToList(), true)); classOperation = Guid.NewGuid(); className = ""; shares.Clear(); await Load(); message = "Allocation class saved."; });
    private Task ReviewClass() => Run(async () => { var c = saved!.Classes.Single(c => c.Id == selectedClass); var request = new UseAllocationClassCommand(allocationOperation, c.Id, c.Version, date, narration, account, funds, income, amount); preview = await Finance.PreviewAllocationClass(request); reviewed = request; });
    private Task PostClass() => Run(async () => { if (reviewed is null) throw new BusinessException("Review the allocation first."); await Finance.PostAllocationClass(reviewed); allocationOperation = Guid.NewGuid(); amount = 0; narration = ""; Invalidate(); await Load(); message = "Reviewed allocation posted."; });
    private Task SaveProject() => Run(async () => { await Finance.SaveProject(new(projectOperation, null, 0, projectCode, projectName, projectCentre, projectStart, null, revenueBudget, expenseBudget, true)); projectOperation = Guid.NewGuid(); projectCode = projectName = ""; revenueBudget = expenseBudget = 0; await Load(); message = "Project registered."; });
    private Task SaveJournal() => Run(async () => { await Finance.ScheduleJournal(new(journalOperation, null, 0, journalName, journalDate, reverse ? reverseDate : null, [new(debitAccount, journalAmount, 0), new(creditAccount, 0, journalAmount)], true)); journalOperation = Guid.NewGuid(); journalName = ""; journalAmount = 0; await Load(); message = "Journal scheduled; no posting has occurred."; });
    private Task PostJournal(ScheduledJournalView j, bool reversing) => Run(async () => { var key = j.Id + ":" + reversing; if (!postingIds.TryGetValue(key, out var operation)) postingIds[key] = operation = Guid.NewGuid(); await Finance.PostScheduledJournal(new(operation, j.Id, j.Version, reversing)); await Load(); message = reversing ? "Scheduled opposite journal posted." : "Scheduled journal posted."; });
}
