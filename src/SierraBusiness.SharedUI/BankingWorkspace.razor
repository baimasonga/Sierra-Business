@inject IBusinessService Business
@inject IBankingService Banking
@inject IFinanceService Finance
<section class="panel"><h2>Banking and supplier credits</h2><p>Import a statement, review each match, and track received cheques through clearance. These records do not initiate bank transfers.</p><button disabled="@busy" @onclick="Refresh">Refresh balances</button></section>
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
@if (snapshot is not null && report is not null)
{
@if (CanWrite)
{
<section class="panel"><h2>Import bank statement</h2><p>CSV columns: Date,Reference,Amount. Use yyyy-MM-dd dates, positive money in and negative money out. Review the preview before importing. Maximum 1 MB / 5,000 rows.</p><div class="form-grid"><label>Bank ledger<select @bind="account">@foreach (var a in Funds) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Statement identifier<input maxlength="100" @bind="reference" /></label><label>Opening balance<input type="number" step="0.01" @bind="opening" /></label><label>Closing balance<input type="number" step="0.01" @bind="closing" /></label><label>CSV file<InputFile OnChange="ReadFile" accept=".csv,text/csv" /></label></div><label>CSV content<textarea rows="6" @bind="csv" @bind:after="ClearPreview"></textarea></label><button disabled="@busy" @onclick="Preview">Preview statement</button>
@if (preview.Count > 0) { <p>@preview.Count transactions · net @preview.Sum(x => x.Amount).ToString("N2") · calculated closing @((opening + preview.Sum(x => x.Amount)).ToString("N2"))</p><table><thead><tr><th>Date</th><th>Reference</th><th>Signed amount</th></tr></thead><tbody>@foreach (var r in preview.Take(20)) { <tr><td>@r.Date</td><td>@r.Reference</td><td>@r.Amount.ToString("N2")</td></tr> }</tbody></table><p>Showing up to 20 preview rows.</p><button class="primary" disabled="@busy" @onclick="Import">Import reviewed statement</button> }
</section>
}
<section class="panel"><h2>Statement register</h2><label>Reason for voiding a statement<input maxlength="160" @bind="voidReason" /></label>@foreach (var s in snapshot.Statements) { <p>@s.Reference · ledger @s.AccountCode · @s.Opening.ToString("N2") → @s.Closing.ToString("N2") · @(s.Voided ? "Voided" : "Active") @if (CanWrite && !s.Voided) { <button disabled="@(busy || string.IsNullOrWhiteSpace(voidReason))" @onclick="() => Void(s)">Void statement</button> }</p> }<p class="hint">Voiding requires cancellation of active matches in Accounting first. Imported history is retained.</p></section>
<section class="panel"><h2>Review statement matches</h2><p>Suggestions require the same signed amount and a posting in the preceding 30 days. Select a document only after checking its reference. Matching never creates a journal entry.</p><div class="table-wrap"><table><thead><tr><th>Statement / date</th><th>Reference / amount</th><th>Book entry</th><th>Action</th></tr></thead><tbody>@foreach (var row in snapshot.Rows) { <tr><td>@snapshot.Statements.Single(x => x.Id == row.StatementId).Reference<br />@row.Date</td><td>@row.Reference<br />@row.Amount.ToString("N2")</td><td>@if (row.MatchId is not null) { <span>Matched</span> } else { <select aria-label="Book entry for @row.Reference" @bind="matches[row.Id]"><option value="@Guid.Empty">Choose reviewed entry</option>@foreach (var c in row.Candidates) { <option value="@c.JournalLineId">Suggested · @c.Date · @c.Number · @c.Narration</option> }@foreach (var e in OtherEntries(row)) { <option value="@e.Id">@e.Date · @e.Number · @e.Party</option> }</select> }</td><td>@if (CanWrite && row.MatchId is null) { <button disabled="@(busy || matches[row.Id] == Guid.Empty)" @onclick="() => Match(row)">Confirm match</button> }</td></tr> }</tbody></table></div></section>
@if (CanWrite)
{
<section class="panel"><h2>Receive cheque against customer debt</h2><div class="form-grid"><label>Outstanding bill<select @bind="invoice"><option value="@Guid.Empty">Select bill</option>@foreach (var b in report.Bills.Where(x => x.Receivable && x.Outstanding > 0)) { <option value="@b.Id">@b.Party · @b.Number · @b.Outstanding.ToString("N2")</option> }</select></label><label>Amount<input type="number" min="0.01" step="0.01" @bind="chequeAmount" /></label><label>Cheque number<input maxlength="100" @bind="chequeReference" /></label><label>Issuing bank<input maxlength="100" @bind="chequeBank" /></label><label>Cheque date<input type="date" @bind="chequeDate" /></label></div><button class="primary" disabled="@busy" @onclick="Receive">Record received cheque</button><details><summary>Register a cheque sale from an earlier version</summary><label>Original cheque sale<select @bind="legacyId"><option value="">Select sale</option>@foreach (var d in legacyDocuments) { <option value="@d.Id">@d.Number · @d.Party · @d.Total.ToString("N2")</option> }</select></label><button disabled="@busy" @onclick="Register">Register existing cheque</button><p>Register only a cheque still physically held and included in the Cheques in hand ledger. Review any manual cheque postings from the earlier version first. No new accounting entry is created.</p></details></section>
}
<section class="panel"><h2>Received cheques</h2><div class="form-grid"><label>Action date<input type="date" @bind="actionDate" /></label><label>Deposit destination<select @bind="chequeAccount">@foreach (var a in Funds) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Reason / bank confirmation<input maxlength="160" @bind="chequeReason" /></label></div><p>Deposited cheques remain in transit until cleared. A bounce creates a collectible customer debt. Undo corrects the latest action and retains its audit history.</p>@foreach (var c in snapshot.Cheques) { <article><h3>@c.Reference · @c.Party · @c.Amount.ToString("N2")</h3><p>@c.Bank · dated @c.ChequeDate · <strong>@c.State</strong></p>@if (CanWrite) { @if (c.State == ChequeState.Received) { <button disabled="@busy" @onclick="() => Act(c, ChequeAction.Deposit)">Record deposit</button> } @if (c.State == ChequeState.Deposited) { <button disabled="@busy" @onclick="() => Act(c, ChequeAction.Clear)">Record clearance</button> } @if (c.State != ChequeState.Bounced) { <button disabled="@busy" @onclick="() => Act(c, ChequeAction.Bounce)">Record bounce</button> } @if (c.Version > 0 && Actor.Permissions.Contains("documents.reverse")) { <button disabled="@busy" @onclick="() => Act(c, ChequeAction.Undo)">Undo latest action</button> } }<details><summary>Action history</summary>@foreach (var e in c.History) { <p>@e.Date · @e.Action → @e.State · @e.Reason</p> }</details><AttachedDocuments Actor="Actor" Target="DocumentLinkTarget.Cheque" Key="@c.Id.ToString()" DefaultType="LibraryDocumentType.Cheque" DefaultTitle="@($"Cheque {c.Reference} · {c.Party}")" Heading="Cheque images and documents" Lazy="true" /></article> }</section>
<section class="panel"><h2>Supplier credits and refunds</h2><table><thead><tr><th>Supplier</th><th>Return</th><th>Original</th><th>Available</th></tr></thead><tbody>@foreach (var c in snapshot.SupplierCredits) { <tr><td>@c.Party</td><td>@c.Number</td><td>@c.Amount.ToString("N2")</td><td>@c.Remaining.ToString("N2")</td></tr> }</tbody></table>
@if (CanWrite) { <div class="form-grid"><label>Credit<select @bind="credit"><option value="@Guid.Empty">Select credit</option>@foreach (var c in snapshot.SupplierCredits.Where(x => x.Remaining > 0)) { <option value="@c.Id">@c.Party · @c.Number · @c.Remaining.ToString("N2")</option> }</select></label><label>Amount<input type="number" min="0.01" step="0.01" @bind="creditAmount" /></label><label>Use<select @bind="refund"><option value="true">Refund received</option><option value="false">Apply to supplier bill</option></select></label>@if (refund) { <label>Received into<select @bind="refundAccount">@foreach (var a in Funds) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label> } else { <label>Outstanding supplier bill<select @bind="supplierBill"><option value="@Guid.Empty">Select same supplier</option>@foreach (var b in report.Bills.Where(x => !x.Receivable && x.Outstanding > 0)) { <option value="@b.Id">@b.Party · @b.Number · @b.Outstanding.ToString("N2")</option> }</select></label> }<label>Reason / refund reference<input maxlength="160" @bind="creditReason" /></label></div><button class="primary" disabled="@busy" @onclick="UseCredit">Post supplier credit use</button> }
</section>
}
@code {
    [Parameter] public Actor Actor { get; set; } = default!;
    private IReadOnlyList<DocumentView> legacyDocuments = []; private BankingSnapshot? snapshot; private FinanceSnapshot? report;
    private bool busy, refund = true; private bool CanWrite => Actor.Permissions.Contains("accounting.write");
    private IEnumerable<LedgerDefinition> Funds => report?.Accounts.Where(x => x.CashOrBank) ?? [];
    private string error = "", message = "", csv = "", reviewedCsv = "", reference = "", voidReason = "", chequeReference = "", chequeBank = "", chequeReason = "", creditReason = "", legacyId = "";
    private int account = 1010, chequeAccount = 1010, refundAccount = 1000;
    private decimal opening, closing, chequeAmount, creditAmount; private Guid invoice, credit, supplierBill;
    private DateOnly chequeDate = DateOnly.FromDateTime(DateTime.UtcNow), actionDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private IReadOnlyList<StatementLineInput> preview = []; private readonly Dictionary<Guid, Guid> matches = [];
    public bool HasDraft => csv.Length > 0 || chequeReference.Length > 0 || chequeAmount != 0 || creditAmount != 0 || chequeReason.Length > 0 || voidReason.Length > 0 || reference.Length > 0 || creditReason.Length > 0 || legacyId.Length > 0 || invoice != Guid.Empty || opening != 0 || closing != 0;
    protected override Task OnInitializedAsync() => Refresh();
    private async Task Load() { snapshot = await Banking.Read(); var state = await Business.Read(Actor); legacyDocuments = state.Documents.Where(x => x.Kind == DocumentKind.Sale && x.Settlement == "Cheque" && !state.Documents.Any(d => d.Reverses == x.Id) && !snapshot.Cheques.Any(c => c.SourceDocumentId == x.Id)).ToArray(); report = await Finance.Read(DateOnly.MinValue, DateOnly.FromDateTime(DateTime.UtcNow)); foreach (var row in snapshot.Rows) matches.TryAdd(row.Id, Guid.Empty); }
    private Task Refresh() => Run(Load);
    private IEnumerable<FinanceEntry> OtherEntries(StatementRowView row) => report!.Entries.Where(x => x.AccountCode == snapshot!.Statements.Single(s => s.Id == row.StatementId).AccountCode && x.Debit - x.Credit == row.Amount && x.ClearedDate is null && !row.Candidates.Any(c => c.JournalLineId == x.Id));
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException or IOException) { error = ex.Message; } catch { error = "Could not complete. Refresh and check the register before retrying."; } finally { busy = false; } }
    private void ClearPreview() { preview = []; reviewedCsv = ""; }
    private Task ReadFile(InputFileChangeEventArgs args) => Run(async () => { using var reader = new StreamReader(args.File.OpenReadStream(1_000_000)); csv = await reader.ReadToEndAsync(); ClearPreview(); });
    private Task Preview() => Run(() => { preview = BankStatementCsv.Parse(csv); reviewedCsv = csv; return Task.CompletedTask; });
    private Task Import() => Run(async () => { if (reviewedCsv != csv || preview.Count == 0) throw new BusinessException("Preview the current CSV first."); await Banking.Import(new(Guid.NewGuid(), account, reference, opening, closing, csv)); csv = reference = ""; opening = closing = 0; ClearPreview(); await Load(); message = "Statement imported. Review and confirm individual matches below."; });
    private Task Void(StatementView s) => Run(async () => { await Banking.VoidStatement(new(Guid.NewGuid(), s.Id, voidReason)); voidReason = ""; await Load(); message = "Statement voided; history retained."; });
    private Task Match(StatementRowView r) => Run(async () => { await Finance.Reconcile(new(Guid.NewGuid(), matches[r.Id], r.Date, r.Reference, r.Id)); await Load(); message = "Reviewed match recorded."; });
    private Task Receive() => Run(async () => { await Banking.ReceiveCheque(new(Guid.NewGuid(), invoice, chequeAmount, chequeReference, chequeBank, chequeDate)); chequeAmount = 0; chequeReference = chequeBank = ""; invoice = Guid.Empty; await Load(); message = "Cheque received and bill allocation recorded."; });
    private Task Register() => Run(async () => { if (!Guid.TryParse(legacyId, out var id)) throw new BusinessException("Select an original cheque sale."); await Banking.RegisterCheque(new(Guid.NewGuid(), id)); legacyId = ""; await Load(); message = "Existing cheque registered."; });
    private Task Act(ChequeView c, ChequeAction action) => Run(async () => { await Banking.ActOnCheque(new(Guid.NewGuid(), c.Id, c.Version, action, actionDate, chequeAccount, chequeReason)); chequeReason = ""; await Load(); message = "Cheque action posted with its accounting entries."; });
    private Task UseCredit() => Run(async () => { await Banking.UseSupplierCredit(new(Guid.NewGuid(), credit, creditAmount, refund ? refundAccount : null, refund ? null : supplierBill, creditReason)); creditAmount = 0; creditReason = ""; await Load(); message = "Supplier credit use posted."; });
}

