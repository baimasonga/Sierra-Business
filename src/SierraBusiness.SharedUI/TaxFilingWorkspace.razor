@inject IComplianceService Compliance
@inject IFinanceService Finance
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
<section class="panel"><h2>Review and record monthly GST</h2><p>Review one completed month and reconcile all branch, invoice and purchase-tax sources before recording its filing reference. Recording creates the reviewed local tax settlement or carry-forward credit and locks that month's earlier accounting dates. Filing with the NRA and making the bank payment remain external steps.</p><div class="form-grid"><label>Month starts<input type="date" @bind="from" @bind:after="Clear" /></label><label>Month ends<input type="date" @bind="to" @bind:after="Clear" /></label></div><button class="secondary" disabled="@busy" @onclick="Review">Review monthly GST</button>
@if (preview is not null)
{
    <p>Output GST @preview.Report.Output.OutputTax.ToString("N2") · Allowable input GST @preview.Report.AllowableInputTax.ToString("N2") · Net payable / credit @preview.Report.NetPayable.ToString("N2") NLe</p>
    @if (preview.Company is not null) { <p>@preview.Company.LegalName · @string.Join(" · ",preview.Company.Ids.Select(i => i.Label+": "+i.Value))</p> }
    @if (Actor.Permissions.Contains("users.manage") && Actor.Permissions.Contains("accounting.write") && accounts is not null)
    {
        <div class="form-grid"><label>Filing or submission reference<input maxlength="80" @bind="filingReference" /></label><label>Return review reason<input maxlength="200" @bind="reason" /></label><label>Local settlement cash/bank<select @bind="bank">@foreach (var a in accounts.Accounts.Where(a => a.CashOrBank)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Separate GST carry-forward asset<select @bind="carryAccount"><option value="0">Choose dedicated carry-forward asset</option>@foreach (var a in accounts.Accounts.Where(a => a.Group == LedgerGroup.Asset && !a.Control && !a.CashOrBank)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Brought-forward GST credit to use<input type="number" min="0" step="0.01" @bind="carryUsed" /></label><label class="check"><input type="checkbox" @bind="reconciled" />I have reconciled all relevant invoice, input-tax and branch sources</label></div>
        <div class="form-grid"><label>Declared net GST on the filed return<input type="number" step="0.01" @bind="declared" /></label><label>Rounding expense account<select @bind="roundingAccount">@foreach (var a in accounts.Accounts.Where(a => a.Group == LedgerGroup.Expense && !a.Control)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label></div><p>Reviewed rounding difference @((declared-preview.Report.NetPayable).ToString("N2")) · Cash/bank settlement @Math.Max(0,declared-carryUsed).ToString("N2") · New carry-forward credit @Math.Max(0,-declared).ToString("N2") NLe</p><button class="primary" disabled="@(busy || !reconciled || carryAccount == 0 || preview.Company?.TaxRegistered != true)" @onclick="Record">Record reviewed GST filing and settlement</button>
    }
}
</section>
@if (Actor.Permissions.Contains("users.manage") && Actor.Permissions.Contains("accounting.write") && accounts is not null && filings.Count > 0)
{
    <section class="panel"><h2>Correct a recorded GST return</h2><p>Record a reviewed amendment after filing it with the NRA. The original return stays unchanged and locked; the correction is posted today. More tax is paid or met from carried credit; less tax becomes carried credit. Penalties and interest are expensed.</p>
    <div class="form-grid"><label>Return to correct<select @bind="correctFiling"><option value="@Guid.Empty">Choose recorded return</option>@foreach (var f in filings) { <option value="@f.Id">@f.From — @f.To · @f.FilingReference</option> }</select></label><label>Amendment reference<input maxlength="80" @bind="correctReference" /></label><label>Correction review reason<input maxlength="300" @bind="correctReason" /></label>
    <label>Output GST change (+ more, − less)<input type="number" step="0.01" @bind="outputChange" /></label><label>Input GST change (+ more, − less)<input type="number" step="0.01" @bind="inputChange" /></label><label>Correction counterpart ledger<select @bind="correctAccount"><option value="0">Choose ledger</option>@foreach (var a in accounts.Accounts.Where(a => !a.Control && !a.CashOrBank && a.Code != 2100)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label>
    <label>Correction carry-forward asset<select @bind="correctCarry"><option value="0">Choose dedicated carry-forward asset</option>@foreach (var a in accounts.Accounts.Where(a => a.Group == LedgerGroup.Asset && !a.Control && !a.CashOrBank)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label><label>Credit to use for additional tax<input type="number" min="0" step="0.01" @bind="correctCarryUsed" /></label><label>Correction cash/bank<select @bind="correctBank">@foreach (var a in accounts.Accounts.Where(a => a.CashOrBank)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label>
    <label>Penalty and interest<input type="number" min="0" step="0.01" @bind="penalty" /></label><label>Penalty expense ledger<select @bind="penaltyAccount"><option value="0">Choose expense ledger</option>@foreach (var a in accounts.Accounts.Where(a => a.Group == LedgerGroup.Expense && !a.Control)) { <option value="@a.Code">@a.Code · @a.Name</option> }</select></label></div>
    <p>Net tax change @((outputChange-inputChange).ToString("N2")) NLe</p><button class="primary" disabled="@(busy || correctFiling == Guid.Empty)" @onclick="Correct">Record reviewed GST return correction</button></section>
}
<section class="panel"><h2>Recorded GST returns</h2><button class="secondary" disabled="@busy" @onclick="Refresh">Refresh GST records</button><div class="table-wrap"><table><thead><tr><th>Tax period</th><th>Reference</th><th>Recorded</th><th>Net tax</th><th>Credit used</th><th>Paid</th><th>New credit</th></tr></thead><tbody>@foreach (var f in filings) { <tr><td>@f.From — @f.To</td><td>@f.FilingReference</td><td>@f.Recorded</td><td>@f.NetTax.ToString("N2")</td><td>@f.CarryUsed.ToString("N2")</td><td>@f.Paid.ToString("N2")</td><td>@f.NewCredit.ToString("N2")</td></tr> }</tbody></table></div>
@if (corrections.Count > 0) { <h3>Corrections</h3><div class="table-wrap"><table><thead><tr><th>Tax period</th><th>Reference</th><th>Recorded</th><th>Output change</th><th>Input change</th><th>Paid</th><th>Credit used</th><th>New credit</th><th>Penalty</th></tr></thead><tbody>@foreach (var c in corrections) { <tr><td>@c.From — @c.To</td><td>@c.Reference</td><td>@c.Recorded</td><td>@c.OutputTaxChange.ToString("N2")</td><td>@c.InputTaxChange.ToString("N2")</td><td>@c.Paid.ToString("N2")</td><td>@c.CarryUsed.ToString("N2")</td><td>@c.NewCredit.ToString("N2")</td><td>@c.Penalty.ToString("N2")</td></tr> }</tbody></table></div> }
</section>
@code {
    private IReadOnlyList<TaxFilingCorrectionView> corrections = []; private Guid correctFiling, correctOperation = Guid.NewGuid(); private string correctReference = "", correctReason = ""; private decimal outputChange, inputChange, correctCarryUsed, penalty; private int correctAccount, correctCarry, correctBank = 1010, penaltyAccount;
    private Task Correct() => Run(async () => { await Compliance.RecordTaxFilingCorrection(new(correctOperation,correctFiling,correctReference,correctReason,outputChange,inputChange,correctAccount,correctBank,correctCarry,correctCarryUsed,penalty,penaltyAccount)); correctOperation = Guid.NewGuid(); correctReference = correctReason = ""; outputChange = inputChange = correctCarryUsed = penalty = 0; corrections = await Compliance.TaxFilingCorrections(); message = "Reviewed GST return correction recorded. The original return is unchanged."; });
    [Parameter] public Actor Actor { get; set; } = default!; private bool busy,reconciled; private string error = "",message = "",filingReference = "",reason = ""; private int bank = 1010,carryAccount; private decimal carryUsed; private Guid operation = Guid.NewGuid(); private TaxFilingPreview? preview; private FinanceSnapshot? accounts; private IReadOnlyList<TaxFilingView> filings = [];
    private DateOnly from = new DateOnly(DateTime.UtcNow.Year,DateTime.UtcNow.Month,1).AddMonths(-1),to = new DateOnly(DateTime.UtcNow.Year,DateTime.UtcNow.Month,1).AddDays(-1);
    private decimal declared; private int roundingAccount = 5100;
    public bool HasDraft => filingReference.Length > 0 || reason.Length > 0 || reconciled || carryUsed != 0 || correctReference.Length > 0 || correctReason.Length > 0 || outputChange != 0 || inputChange != 0;
    protected override Task OnInitializedAsync() => Refresh();
    private Task Refresh() => Run(async () => { filings = await Compliance.TaxFilings(); corrections = await Compliance.TaxFilingCorrections(); accounts = await Finance.Read(new(2000,1,1),DateOnly.FromDateTime(DateTime.UtcNow)); });
    private void Clear() { preview = null; reconciled = false; }
    private Task Review() => Run(async () => { preview = await Compliance.PreviewTaxFiling(from,to); declared = preview.Report.NetPayable; });
    private Task Record() => Run(async () => { if (preview is null) throw new BusinessException("Review the monthly GST working paper first."); await Compliance.RecordTaxFiling(new(operation,from,to,preview.CalculationFingerprint,filingReference,reason,bank,carryAccount,carryUsed,reconciled,declared,roundingAccount)); operation = Guid.NewGuid(); preview = null; filingReference = reason = ""; carryUsed = 0; reconciled = false; filings = await Compliance.TaxFilings(); message = "Reviewed GST return and settlement recorded. The reporting month is locked."; });
    private async Task Run(Func<Task> work) { if (busy) return; busy = true; error = message = ""; try { await work(); } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException) { error = e.Message; } catch { error = "The GST record could not complete. Refresh recorded returns before retrying."; } finally { busy = false; } }
}
