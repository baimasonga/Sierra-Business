@inject IInventoryService Inventory
@inject IBusinessService Business
<section class="panel" aria-label="Consignment and delivery rejections">
    <h2>Consignment and pre-invoice rejections</h2>
    <p class="hint">Company-owned consignment stays in your inventory: transfer it to a company-owned partner site using the warehouse transfer screen, then record a sale from that site or transfer unsold goods back. Supplier-owned custody is reported separately and creates no owned stock or payable until you accept it.</p>
    @if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
    @if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
    <fieldset disabled="@busy"><legend>Register partner site</legend><div class="form-grid"><label>Consignment site code<input maxlength="20" @bind="siteCode" placeholder="CON-PARTNER" /></label><label>Consignment partner<input maxlength="160" @bind="partner" /></label><label>Stock ownership<select @bind="ownership"><option value="@ConsignmentOwnership.CompanyOwned">Company owned, held by partner</option><option value="@ConsignmentOwnership.SupplierOwned">Supplier owned, held in custody</option></select></label></div><button class="secondary" @onclick="SaveSite">Register consignment site</button></fieldset>
    <fieldset disabled="@busy"><legend>Receive supplier-owned custody stock</legend><div class="form-grid"><label>Supplier custody site<select @bind="site"><option value="">Choose supplier-owned site</option>@foreach (var s in sites.Where(s => s.Ownership == ConsignmentOwnership.SupplierOwned)) { <option value="@s.Code">@s.Code · @s.Partner</option> }</select></label><label>Custody product<select @bind="product"><option value="@Guid.Empty">Choose product</option>@foreach (var p in products) { <option value="@p.Id">@p.Sku · @p.Name</option> }</select></label><label>Custody date<input type="date" @bind="date" /></label><label>Custody quantity<input type="number" step="0.0001" min="0.0001" @bind="quantity" /></label><label>Reference unit cost (NLe)<input type="number" step="0.0001" min="0.0001" @bind="cost" /></label><label>Custody serial<input maxlength="100" @bind="serial" /></label><label>Custody batch<input maxlength="100" @bind="batch" /></label><label>Custody expiry<input type="date" @bind="expiry" /></label><label>Custody reference<input maxlength="160" @bind="reference" /></label></div><button class="secondary" @onclick="Receive">Record supplier custody receipt</button></fieldset>
    <fieldset disabled="@busy"><legend>Accept or return custody stock</legend>
        <p class="hint">Acceptance posts owned stock and a supplier bill. Returning unaccepted custody units creates no financial journal.</p>
        <div class="form-grid"><label>Remaining custody lot<select @bind="receiveId" @bind:after="ChooseCustody"><option value="@Guid.Empty">Choose custody lot</option>@foreach (var c in custody.Where(c => c.Remaining > 0)) { <option value="@c.ReceiveId">@c.Site · @c.Sku · @c.Serial @c.Batch · @c.Remaining @c.Unit</option> }</select></label><label>Accept / return quantity<input type="number" step="0.0001" min="0.0001" @bind="actionQuantity" /></label><label>Agreed purchase unit cost (NLe)<input type="number" step="0.0001" min="0.0001" @bind="acceptCost" /></label><label>Owned-stock receiving warehouse<select @bind="location">@foreach (var l in locations) { <option value="@l.Code">@l.Code · @l.Name</option> }</select></label><label>Custody action date<input type="date" @bind="actionDate" /></label><label>Custody return reason<input maxlength="160" @bind="custodyReason" /></label></div><button class="primary" @onclick="Accept">Accept and post supplier bill</button><button class="secondary" @onclick="Return">Return unaccepted custody units</button>
        <div class="table-wrap"><table><thead><tr><th>Custody lot</th><th>Received</th><th>Accepted</th><th>Returned</th><th>Remaining</th><th>Ownership</th></tr></thead><tbody>@foreach (var c in custody) { <tr><td>@c.Site · @c.Sku · @c.Reference</td><td>@c.Received</td><td>@c.Accepted</td><td>@c.Returned</td><td>@c.Remaining @c.Unit</td><td>Supplier owned; excluded from inventory assets</td></tr> }</tbody></table></div>
    </fieldset>
    <fieldset disabled="@busy"><legend>Reject goods before customer invoicing</legend><p class="hint">Returned goods restore inventory and reduce goods delivered awaiting invoice. The order remainder reopens, and only the accepted delivery quantity may be invoiced. Use sales returns for goods already invoiced.</p>
        <div class="form-grid"><label>Uninvoiced delivery<select @bind="deliveryId" @bind:after="ChooseDelivery"><option value="@Guid.Empty">Choose delivery</option>@foreach (var d in deliveries) { <option value="@d.Id">@d.Number · @d.Party</option> }</select></label><label>Rejected delivery identity<select @bind="deliveryLine"><option value="-1">Choose stock identity</option>@if (deliveries.SingleOrDefault(d => d.Id == deliveryId) is { } selected) { @for (var i = 0; i < selected.Lines.Count; i++) { var l = selected.Lines[i]; <option value="@i">@l.Name · @l.Serial @l.Batch · remaining @(l.OriginalQuantity-l.ReturnedQuantity)</option> } }</select></label><label>Rejected base units<input type="number" min="0.0001" step="0.0001" @bind="rejectedQuantity" /></label><label>Rejection date<input type="date" @bind="rejectionDate" /></label><label>Rejection reason<input maxlength="160" @bind="rejectionReason" /></label></div><button class="primary" @onclick="Reject">Return rejected delivery goods</button>
    </fieldset>
</section>
@code {
    [Parameter,EditorRequired] public Actor Actor { get; set; } = default!; private bool busy; private string error = "",message = "",siteCode = "",partner = "",site = "",serial = "",batch = "",reference = "",custodyReason = "",location = "MAIN",rejectionReason = ""; private ConsignmentOwnership ownership; private Guid product,receiveId,deliveryId; private int deliveryLine = -1; private decimal quantity = 1,cost = 1,actionQuantity = 1,acceptCost = 1,rejectedQuantity = 1; private DateOnly date = DateOnly.FromDateTime(DateTime.UtcNow),actionDate = DateOnly.FromDateTime(DateTime.UtcNow),rejectionDate = DateOnly.FromDateTime(DateTime.UtcNow); private DateOnly? expiry;
    private IReadOnlyList<ProductView> products = []; private IReadOnlyList<ConsignmentSiteView> sites = []; private IReadOnlyList<CustodyStockView> custody = []; private IReadOnlyList<LocationView> locations = []; private IReadOnlyList<PendingDeliveryView> deliveries = [];
    public bool HasDraft => siteCode.Length > 0 || reference.Length > 0 || custodyReason.Length > 0 || rejectionReason.Length > 0;
    protected override Task OnInitializedAsync() => Run(Load);
    private async Task Load() { products = (await Business.Read(Actor)).Products; sites = await Inventory.ConsignmentSites(); custody = await Inventory.CustodyStock(); locations = await Inventory.Locations(); deliveries = await Inventory.PendingDeliveries(); }
    private static string? Identity(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim().ToUpperInvariant();
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } finally { busy = false; } }
    private Task SaveSite() => Run(async () => { await Inventory.SaveConsignmentSite(new(Guid.NewGuid(),siteCode.Trim().ToUpperInvariant(),partner.Trim(),ownership)); siteCode = partner = ""; await Load(); message = "Consignment site registered. Company-owned sites are available in warehouse transfers."; });
    private Task Receive() => Run(async () => { await Inventory.ReceiveCustody(new(Guid.NewGuid(),site,date,product,quantity,cost,reference,Identity(serial),Identity(batch),expiry)); reference = serial = batch = ""; expiry = null; await Load(); message = "Supplier-owned custody recorded without an inventory asset or payable."; });
    private void ChooseCustody() { var lot = custody.SingleOrDefault(c => c.ReceiveId == receiveId); if (lot is not null) { actionQuantity = lot.Serial is null ? Math.Min(1,lot.Remaining) : 1; acceptCost = lot.ReferenceUnitCost; } }
    private Task Accept() => Run(async () => { var c = custody.SingleOrDefault(c => c.ReceiveId == receiveId) ?? throw new BusinessException("Choose a custody lot."); await Business.Post(Actor,new(Guid.NewGuid(),DocumentKind.Receipt,c.Partner,actionDate,[new(c.ProductId,actionQuantity,acceptCost,Serial:c.Serial,Batch:c.Batch,Expiry:c.Expiry)],null,Location:location,CustodyReceiveId:c.ReceiveId)); receiveId = Guid.Empty; await Load(); message = "Accepted custody units posted as owned stock and a supplier bill."; });
    private Task Return() => Run(async () => { await Inventory.ReturnCustody(new(Guid.NewGuid(),receiveId,actionDate,actionQuantity,custodyReason)); custodyReason = ""; receiveId = Guid.Empty; await Load(); message = "Unaccepted custody units returned. No financial journal posted."; });
    private void ChooseDelivery() { deliveryLine = -1; rejectionReason = ""; }
    private Task Reject() => Run(async () => { var delivery = deliveries.SingleOrDefault(d => d.Id == deliveryId) ?? throw new BusinessException("Choose an uninvoiced delivery."); if (deliveryLine < 0 || deliveryLine >= delivery.Lines.Count) throw new BusinessException("Choose the rejected stock identity."); var l = delivery.Lines[deliveryLine]; await Inventory.RejectDelivery(new(Guid.NewGuid(),delivery.Id,rejectionDate,rejectionReason,[new(l.ProductId,l.Serial,l.Batch,l.Expiry,rejectedQuantity)])); rejectionReason = ""; deliveryLine = -1; await Load(); message = "Rejected goods restored and the order remainder reopened. Invoice only the accepted delivery quantity."; });
}
