@inject IPosService Pos
@inject IInventoryManagement Management
<section class="panel"><h2>Barcode catalogue</h2><p>Scan a SKU directly or assign product and pack barcodes. Mapping changes retain history; replace printed labels after reassignment.</p></section>
@if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }
@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
@if (Actor.Permissions.Contains("catalogue.write")) {
<section class="panel"><h2>@(editing is null ? "Assign barcode" : "Change barcode assignment")</h2><fieldset disabled="@busy"><div class="form-grid"><label>Product<select @bind="product"><option value="@Guid.Empty">Choose product</option>@foreach (var p in Products) { <option value="@p.Id">@p.Sku · @p.Name</option> }</select></label><label>Barcode<input @bind="code" maxlength="80" disabled="@(editing is not null)" /></label><label>Base units per scan<input type="number" min="0.0001" step="0.0001" @bind="conversion" /></label>
@if (editing is not null) { <label>Status<select @bind="retired"><option value="false">Active</option><option value="true">Retired — disable scanning</option></select></label><label>Change reason<input @bind="reason" maxlength="160" /></label> }</div><button class="primary" @onclick="Save">@(editing is null ? "Assign barcode" : "Save assignment change")</button><button class="secondary" @onclick="Clear">Clear form</button></fieldset></section> }
<section class="panel"><label>Find barcode or product<input @bind="search" @bind:event="oninput" /></label><table><thead><tr><th>Barcode</th><th>Product</th><th>Base units / scan</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var b in barcodes.Where(x => (x.Code + " " + Products.FirstOrDefault(p => p.Id == x.ProductId)?.Name).Contains(search, StringComparison.OrdinalIgnoreCase))) { <tr><td class="code">@b.Code</td><td>@Products.SingleOrDefault(x => x.Id == b.ProductId)?.Name</td><td>@b.Conversion</td><td>@(b.Retired ? "Retired" : "Active")</td><td>@if (Actor.Permissions.Contains("catalogue.write")) { <button class="secondary" disabled="@busy" @onclick="() => Edit(b)">Edit</button> } @if (!b.Retired) { <button class="secondary" disabled="@busy" @onclick="() => Label(b)">Labels</button> }</td></tr> }</tbody></table></section>
@if (label is not null) { <section class="panel"><h2>Print barcode labels</h2><label>Copies (1–100)<input type="number" min="1" max="100" @bind="copies" /></label><p class="hint">Print at actual size. Verify one printed label with your scanner before printing a full batch.</p><PrintButton Target="barcode-labels" /><div id="barcode-labels">@for (var i = 0; i < Math.Clamp(copies, 1, 100); i++) { <div style="display:inline-block;width:85mm;padding:4mm;margin:2mm;text-align:center;break-inside:avoid;border:1px solid #ddd"><strong>@Products.First(x => x.Id == label.ProductId).Name</strong><div>@((MarkupString)labelSvg)</div><div>@label.Code · @label.Conversion base units</div></div> }</div></section> }
@code {
 [Parameter] public Actor Actor { get; set; } = default!;
 [Parameter] public IReadOnlyList<ProductView> Products { get; set; } = [];
 private IReadOnlyList<ManagedBarcode> barcodes = []; private ManagedBarcode? editing, label; private Guid product, operation = Guid.NewGuid(); private string code = "", reason = "", search = "", labelSvg = "", error = "", message = ""; private decimal conversion = 1; private bool busy, retired; private int copies = 1;
 public bool HasDraft => product != Guid.Empty || code.Length > 0 || conversion != 1;
 protected override Task OnInitializedAsync() => Run(async () => barcodes = await Management.Barcodes());
 private void Clear() { editing = null; product = Guid.Empty; code = reason = ""; conversion = 1; retired = false; operation = Guid.NewGuid(); }
 private void Edit(ManagedBarcode b) { Clear(); editing = b; product = b.ProductId; code = b.Code; conversion = b.Conversion; retired = b.Retired; }
 private void Label(ManagedBarcode b) { error = ""; try { labelSvg = BarcodeLabel.Svg(b.Code); label = b; } catch (ArgumentException ex) { label = null; error = ex.Message; } }
 private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } catch { error = "Could not complete. Refresh before retrying."; } finally { busy = false; } }
 private Task Save() => Run(async () => { if (editing is null) await Pos.AddBarcode(new(operation, product, code, conversion)); else await Management.ChangeBarcode(new(operation, editing.Id, editing.Version, product, conversion, retired, reason)); Clear(); label = null; barcodes = await Management.Barcodes(); message = "Barcode assignment saved."; });
}
