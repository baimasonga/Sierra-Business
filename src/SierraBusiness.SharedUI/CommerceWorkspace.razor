@using System.Text.Json
@inject ICommerceService Commerce
@inject IBusinessService Business
@inject IOrderService Orders
@inject IInventoryService Inventory
@inject IFinanceService Finance
<section class="panel"><h2>Negotiated sales, deliveries and customer credits</h2><button class="secondary" disabled="@busy" @onclick="Refresh">Refresh</button><p>Agree a price with the customer. The server checks the confidential minimum before accepting quotations, orders, deliveries and invoices. Products without an approved pricing policy cannot be sold.</p></section>
@if (error.Length > 0) { <div role="alert" class="notice error">@error</div> }
@if (message.Length > 0) { <div role="status" class="notice success">@message</div> }
@if (Actor.Permissions.Contains("pricing.manage"))
{
<section class="panel"><h2>Confidential minimum prices · authorized managers only</h2><p>Not printed or returned in ordinary catalogue/sales data. Amounts are per base unit, excluding sales tax.</p><label>Product<select @bind="priceProduct"><option value="@Guid.Empty">Choose product</option>@foreach (var p in prices) { <option value="@p.ProductId">@p.Sku · @p.Name</option> }</select></label><label>Minimum acceptable price / NLe<input type="number" min="0.0001" step="0.0001" @bind="minimum" /></label><label>Reason<input @bind="priceReason" maxlength="160" /></label><button class="primary" disabled="@busy" @onclick="SavePrice">Save confidential minimum</button><details><summary>View configured minimums</summary><table><thead><tr><th>SKU / product</th><th>Confidential minimum</th></tr></thead><tbody>@foreach (var p in prices) { <tr><td>@p.Sku · @p.Name</td><td>@(p.MinimumPrice?.ToString("N4") ?? "Not configured — sales blocked")</td></tr> }</tbody></table></details></section>
}
@if (Actor.Permissions.Contains("sales.create"))
{
<section class="panel"><h2>Reserve stock for a sales order</h2><div class="form-grid"><label>Order<select @bind="orderId" @bind:after="ResetProduct"><option value="@Guid.Empty">Choose open sales order</option>@foreach (var o in orders.Where(x => x.Type == OrderType.SalesOrder && !x.Closed)) { <option value="@o.Id">@o.Number · @o.Party</option> }</select></label><label>Product<select @bind="productId"><option value="@Guid.Empty">Choose order product</option>@foreach (var p in orders.SingleOrDefault(x => x.Id == orderId)?.Lines ?? []) { <option value="@p.ProductId">@p.Name · remaining @(p.Quantity - p.Fulfilled)</option> }</select></label><label>Warehouse<select @bind="location">@foreach (var l in locations) { <option value="@l.Code">@l.Name</option> }</select></label><label>Quantity in base units<input type="number" min="0.0001" step="0.0001" @bind="quantity" /></label><label>Serial<input @bind="serial" /></label><label>Batch<input @bind="batch" /></label><label>Expiry<input type="date" @bind="expiry" /></label></div><button class="primary" disabled="@busy" @onclick="Reserve">Reserve stock</button></section>
}
<section class="panel"><h2>Active reservations</h2><p>Other orders, walk-in sales, transfers and stock reductions cannot use reserved quantities. Closing an order releases its reservations; stock issues consume matching reservations.</p><table><thead><tr><th>Order / customer</th><th>Product / identity</th><th>Warehouse</th><th>Remaining</th><th></th></tr></thead><tbody>@foreach (var r in reservations) { <tr><td>@r.OrderNumber<br />@r.Party</td><td>@r.Product @r.Serial @r.Batch @r.Expiry</td><td>@r.Location</td><td>@r.Remaining</td><td>@if (Actor.Permissions.Contains("sales.create")) { <button disabled="@busy" @onclick="() => Release(r.Id)">Release</button> }</td></tr> }</tbody></table><label>Release reason<input @bind="releaseReason" maxlength="160" /></label></section>
<section class="panel"><h2>Deliveries awaiting invoice</h2><p>Create delivery notes from Orders &amp; quotations. Each delivery issues stock once; invoicing it records the sale without issuing stock again. Invoice each complete delivery; use separate delivery notes for staged invoices.</p><label>Invoice settlement<select @bind="settlement"><option>Credit</option><option>Cash</option><option>BankTransfer</option></select></label>@if (settlement == "BankTransfer") { <label>Bank<input @bind="bank" /></label><label>Payment reference<input @bind="paymentReference" /></label> }<label>Invoice due date<input type="date" @bind="dueDate" /></label><table><thead><tr><th>Delivery</th><th>Customer</th><th>Date</th><th></th></tr></thead><tbody>@foreach (var d in PendingDeliveries) { <tr><td>@d.Number</td><td>@d.Party</td><td>@d.BusinessDate</td><td>@if (Actor.Permissions.Contains("sales.create")) { <button disabled="@busy" @onclick="() => Invoice(d)">Invoice delivery</button> }</td></tr> }</tbody></table></section>
@if (Actor.Permissions.Contains("accounting.read"))
{
<section class="panel"><h2>Customer credit balances</h2><p>Refund part/all of a credit, or apply it to an outstanding invoice for the same customer. Use Documents to print the resulting refund or allocation record.</p><table><thead><tr><th>Customer / credit note</th><th>Original</th><th>Remaining</th></tr></thead><tbody>@foreach (var c in credits) { <tr><td>@c.Party<br />@c.Number</td><td>@c.Amount.ToString("N2")</td><td>@c.Remaining.ToString("N2")</td></tr> }</tbody></table>
@if (Actor.Permissions.Contains("accounting.write")) { <div class="form-grid"><label>Customer credit<select @bind="creditId"><option value="@Guid.Empty">Choose credit</option>@foreach (var c in credits.Where(x => x.Remaining > 0)) { <option value="@c.Id">@c.Party · @c.Remaining.ToString("N2") · @c.Number</option> }</select></label><label>Amount<input type="number" min="0.01" step="0.01" @bind="amount" /></label><label>Action<select @bind="creditAction"><option>Refund</option><option>Apply to invoice</option></select></label>@if (creditAction == "Refund") { <label>Refund account<select @bind="refundAccount">@foreach (var a in accounts.Where(x => x.CashOrBank)) { <option value="@a.Code">@a.Name</option> }</select></label> } else { <label>Outstanding invoice<select @bind="invoiceId"><option value="@Guid.Empty">Choose invoice</option>@foreach (var b in bills.Where(x => x.Receivable)) { <option value="@b.Id">@b.Party · @b.Outstanding.ToString("N2") · @b.Number</option> }</select></label> }<label>Reason<input @bind="creditReason" /></label></div><button class="primary" disabled="@busy" @onclick="UseCredit">Post credit use</button> }</section>
}
@code {
    [Parameter] public Actor Actor { get; set; } = default!;
    private IReadOnlyList<PricePolicyView> prices = []; private IReadOnlyList<ReservationView> reservations = []; private IReadOnlyList<CreditView> credits = []; private IReadOnlyList<OrderView> orders = []; private IReadOnlyList<LocationView> locations = []; private IReadOnlyList<LedgerDefinition> accounts = []; private IReadOnlyList<OutstandingBill> bills = []; private BusinessSnapshot? data;
    private string error = "", message = "", priceReason = "", releaseReason = "", serial = "", batch = "", location = "MAIN", settlement = "Credit", creditAction = "Refund", creditReason = "", bank = "", paymentReference = "";
    private Guid priceProduct, orderId, productId, creditId, invoiceId; private decimal minimum, quantity = 1, amount; private int refundAccount = 1000; private DateOnly? expiry; private DateOnly dueDate = DateOnly.FromDateTime(DateTime.UtcNow); private bool busy;
    private Guid priceOperation = Guid.NewGuid(), reserveOperation = Guid.NewGuid(), creditOperation = Guid.NewGuid();
    private readonly Dictionary<Guid, Guid> invoiceOperations = [];
    public bool HasDraft => priceProduct != Guid.Empty || minimum != 0 || creditId != Guid.Empty || bank.Length > 0 || paymentReference.Length > 0 || priceReason.Length > 0 || orderId != Guid.Empty || amount != 0 || creditReason.Length > 0 || releaseReason.Length > 0;
    private IEnumerable<DocumentView> PendingDeliveries => data?.Documents.Where(d => d.Kind == DocumentKind.Delivery && !data.Documents.Any(r => r.Reverses == d.Id) && !data.Documents.Any(i => i.Kind == DocumentKind.Sale && !data.Documents.Any(r => r.Reverses == i.Id) && DeliveryId(i) == d.Id)) ?? [];
    private static Guid? DeliveryId(DocumentView d) { using var j = JsonDocument.Parse(d.Detail); return j.RootElement.GetProperty("Request").Deserialize<TradeCommand>()?.DeliveryId; }
    protected override Task OnInitializedAsync() => Refresh();
    private async Task Reload() { data = await Business.Read(Actor); orders = await Orders.Read(); reservations = await Commerce.Reservations(); locations = await Inventory.Locations(); if (Actor.Permissions.Contains("pricing.manage")) prices = await Commerce.Prices(); if (Actor.Permissions.Contains("accounting.read")) { credits = await Commerce.Credits(); var f = await Finance.Read(new(DateTime.UtcNow.Year, 1, 1), DateOnly.FromDateTime(DateTime.UtcNow)); bills = f.Bills; accounts = f.Accounts; } }
    private Task Refresh() => Run(Reload);
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = message = ""; try { await action(); } catch (Exception ex) when (ex is BusinessException or UnauthorizedAccessException) { error = ex.Message; } catch { error = "Operation could not complete. Refresh and check saved records before retrying."; } finally { busy = false; } }
    private void ResetProduct() => productId = Guid.Empty;
    private Task SavePrice() => Run(async () => { await Commerce.SetPrice(new(priceOperation, priceProduct, minimum, priceReason)); priceOperation = Guid.NewGuid(); priceReason = ""; priceProduct = Guid.Empty; minimum = 0; await Reload(); message = "Confidential minimum updated."; });
    private Task Reserve() => Run(async () => { await Commerce.Reserve(new(reserveOperation, orderId, productId, location, quantity, serial, batch, expiry)); reserveOperation = Guid.NewGuid(); orderId = productId = Guid.Empty; serial = batch = ""; expiry = null; quantity = 1; await Reload(); message = "Stock reserved."; });
    private Task Release(Guid id) => Run(async () => { await Commerce.Release(new(Guid.NewGuid(), id, releaseReason)); releaseReason = ""; await Reload(); message = "Reservation released."; });
    private Task UseCredit() => Run(async () => { await Commerce.UseCredit(new(creditOperation, creditId, amount, creditAction == "Refund" ? refundAccount : null, creditAction == "Refund" ? null : invoiceId, creditReason)); creditOperation = Guid.NewGuid(); creditId = invoiceId = Guid.Empty; amount = 0; creditReason = ""; await Reload(); message = "Customer credit use posted."; });
    private Task Invoice(DocumentView d) => Run(async () => { using var j = JsonDocument.Parse(d.Detail); var request = j.RootElement.GetProperty("Request").Deserialize<TradeCommand>()!; if (!invoiceOperations.TryGetValue(d.Id, out var operation)) invoiceOperations[d.Id] = operation = Guid.NewGuid(); await Business.Post(Actor, request with { OperationId = operation, Kind = DocumentKind.Sale, BusinessDate = DateOnly.FromDateTime(DateTime.UtcNow), DeliveryId = d.Id, Payment = settlement == "Cash" ? PaymentMethod.Cash : settlement == "BankTransfer" ? PaymentMethod.BankTransfer : null, DueDate = dueDate, Bank = bank, PaymentReference = paymentReference, PaymentDate = DateOnly.FromDateTime(DateTime.UtcNow) }); await Reload(); message = "Delivery invoiced. No second stock issue was made."; });
}

