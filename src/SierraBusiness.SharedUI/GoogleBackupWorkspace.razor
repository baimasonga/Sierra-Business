@using Microsoft.JSInterop
@inject IServiceProvider Services
@inject IJSRuntime JS
@if (manager is not null)
{
    <section class="panel"><h2>Encrypted Google Drive backups</h2><p>Google receives encrypted backup files. Save the recovery key somewhere separate from this computer and Drive; losing it makes encrypted backups unreadable. Google sign-in opens your normal browser.</p>
    @if (error.Length > 0) { <div class="notice error" role="alert">@error</div> }@if (message.Length > 0) { <div class="notice success" role="status">@message</div> }
    <fieldset disabled="@busy"><label>Administrator-provided Google desktop credentials file<InputFile accept=".json" OnChange="Configure" /></label>
    @if (status is { Configured: true }) { <p>@status.Message</p><button class="secondary" @onclick="ExportKey">Save backup recovery key</button><label class="check"><input type="checkbox" @bind="keySaved" />I have saved the recovery key in a separate secure location</label><button class="secondary" disabled="@(!keySaved)" @onclick="ConfirmKey">Confirm recovery key saved</button><button class="secondary" disabled="@(!status.RecoveryConfirmed)" @onclick="Connect">@(status.Connected ? "Reconnect Google Drive" : "Sign in to Google Drive")</button>
    @if (status.Connected) { <label class="check"><input type="checkbox" checked="@status.Enabled" @onchange="Enable" />Upload encrypted copies when verified local backups are created</label><p>Drive folder identifier: @status.FolderId</p><button class="secondary" disabled="@(!status.Enabled)" @onclick="Upload">Upload latest verified backup</button><button class="text-button" @onclick="Disconnect">Disconnect backup uploads</button> } }
    <details><summary>Recover a downloaded encrypted backup</summary><p>Download the .rokela-backup file from your Google Drive folder. Importing verifies its recovery key, checksum, version, company branch and protected history. It adds a local backup to the register; restore still requires the normal RESTORE confirmation.</p><label>Recovery key<input type="password" autocomplete="off" @bind="recoveryKey" /></label><label>Downloaded encrypted backup<InputFile accept=".rokela-backup" OnChange="Import" /></label></details></fieldset></section>
}
@code {
    [Parameter] public EventCallback OnImported { get; set; }
    private ICloudBackupManager? manager; private CloudBackupStatus? status; private bool busy, keySaved; private string error = "", message = "", recoveryKey = "";
    public bool HasDraft => recoveryKey.Length > 0;
    protected override Task OnInitializedAsync() { manager = Services.GetService(typeof(ICloudBackupManager)) as ICloudBackupManager; return manager is null ? Task.CompletedTask : Run(Refresh); }
    private async Task Refresh() => status = await manager!.Status();
    private async Task Run(Func<Task> work) { if (busy) return; busy = true; error = message = ""; try { await work(); } catch (Exception e) when (e is BusinessException or UnauthorizedAccessException or IOException or System.Security.Cryptography.CryptographicException or JSException or OperationCanceledException or System.Text.Json.JsonException or HttpRequestException or PlatformNotSupportedException) { error = e is OperationCanceledException ? "Google backup setup timed out. Check the browser and retry." : e is System.Text.Json.JsonException ? "Use the administrator-provided Google Desktop app credentials file." : e is System.Security.Cryptography.CryptographicException ? "The recovery key or protected credentials could not be verified." : e.Message; } catch { error = "Google backup setup could not complete. Local backups remain available."; } finally { busy = false; } }
    private Task Configure(InputFileChangeEventArgs args) => Run(async () => { using var reader = new StreamReader(args.File.OpenReadStream(16384)); await manager!.Configure(await reader.ReadToEndAsync()); await Refresh(); keySaved = false; message = "Google backup credentials configured. Save and confirm the recovery key before sign-in."; });
    private Task ExportKey() => Run(async () => { var key = await manager!.RecoveryKey(); var bytes = System.Text.Encoding.UTF8.GetBytes(key+Environment.NewLine); var name = "rokela-backup-recovery-key.txt"; if (Services.GetService(typeof(IFileExport)) is IFileExport export) message = "Recovery key saved to " + await export.Save(name,bytes) + ". Move it to a separate secure location."; else { await JS.InvokeVoidAsync("sierraDownload",name,Convert.ToBase64String(bytes)); message = "Recovery key downloaded. Save it to a separate secure location."; } });
    private Task ConfirmKey() => Run(async () => { if (!keySaved) throw new BusinessException("Save the key and tick the confirmation first."); await manager!.ConfirmRecoveryKey(); await Refresh(); message = "Recovery-key confirmation saved."; });
    private Task Connect() => Run(async () => { await manager!.Connect(); await Refresh(); message = "Google Drive connected. Enable uploads when ready."; });
    private Task Enable(ChangeEventArgs args) => Run(async () => { await manager!.SetEnabled(args.Value is true); await Refresh(); message = status!.Enabled ? "Encrypted Google Drive uploads enabled." : "Google Drive uploads disabled."; });
    private Task Upload() => Run(async () => message = await manager!.UploadLatest());
    private Task Disconnect() => Run(async () => { await manager!.Disconnect(); await Refresh(); message = "Backup uploads disconnected. Existing Drive files and local backups are retained."; });
    private Task Import(InputFileChangeEventArgs args) => Run(async () => { await using var stream = args.File.OpenReadStream(2L*1024*1024*1024); var name = await manager!.ImportEncrypted(stream,recoveryKey); recoveryKey = ""; await OnImported.InvokeAsync(); message = "Verified cloud backup added to the local register: " + name; });
}
