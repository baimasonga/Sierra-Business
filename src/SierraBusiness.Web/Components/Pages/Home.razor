@page "/"
@attribute [Authorize]
@inject AuthenticationStateProvider Authentication
<PageTitle>Rokela Business Admin · Workspace</PageTitle>
@if (actor is not null) { <Workspace Actor="actor" UserName="@userName" /> }
@code {
    private Actor? actor; private string userName = "";
    protected override async Task OnInitializedAsync() { var user = (await Authentication.GetAuthenticationStateAsync()).User; userName = user.Identity?.Name ?? ""; actor = new(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "", user.FindFirst("branch")?.Value ?? "", user.FindAll("permission").Select(x => x.Value).ToHashSet()); }
}
